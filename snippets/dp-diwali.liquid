        <p class="dp-diwali-hero__title">Happy<br>Diwali</p>
        <p class="dp-diwali-hero__sub">Festival of Lights</p>
        <span class="dp-medal__ornament dp-medal__ornament--flip" aria-hidden="true"><svg viewBox="0 0 160 22" aria-hidden="true"><path d="M6 11h34M120 11h34" fill="none" stroke="#b8860b" stroke-width="1.4" stroke-linecap="round"/><path d="M44 11c8-8 16-8 20 0M116 11c-8-8-16-8-20 0" fill="none" stroke="#c8962e" stroke-width="1.5"/><path d="M80 2.5c5 3.4 7.2 6 0 12.2-7.2-6.2-5-8.8 0-12.2z" fill="#d4a24a"/><circle cx="58" cy="11" r="1.7" fill="#c8962e"/><circle cx="102" cy="11" r="1.7" fill="#c8962e"/></svg></span>
