</section>
<script>
  (function () {
    var lights = document.querySelector('.dp-header-lights');
    var bar = document.querySelector('.header-top');
    if (lights && bar) bar.appendChild(lights);

    function placeHero() {
      var hero = document.querySelector('.dp-diwali-hero');
      if (!hero) return;
      var slide = document.querySelector('[data-wrapper-slidershow]');
      if (!slide) { hero.remove(); return; }
      var section = slide.closest('.shopify-section') || slide;
      if (section.parentNode) {
        section.parentNode.insertBefore(hero, section);
        section.style.display = 'none';
      }
    }
    if (document.readyState === 'loading') document.addEventListener('DOMContentLoaded', placeHero);
    else placeHero();

    var hero = document.querySelector('.dp-diwali-hero');
    if (!hero) return;
    if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) return;
    var canHover = window.matchMedia('(hover: hover) and (pointer: fine)').matches;

    var activeStop = null;

    hero.querySelectorAll('.dp-jar3d').forEach(function (jar) {
      var photo = jar.querySelector('img');
      if (!photo) return;
      var canvas = document.createElement('canvas');
      canvas.className = 'dp-jar3d__spin';
      canvas.setAttribute('aria-hidden', 'true');
      jar.appendChild(canvas);
      var ctx = canvas.getContext('2d');
      var frontImg = null;
      var backImg = null;
      var spin = 0;
      var speed = 0;
      var raf = 0;
      var last = 0;
      var running = false;
      var shade = null;
      var spec = null;
      var hold = document.createElement('canvas');
      var mask = document.createElement('canvas');
      var holdCtx = hold.getContext('2d');
      var maskCtx = mask.getContext('2d');
      var turn = Math.PI * 2 / 0.48;

      function loadPair() {
        if (frontImg) return Promise.resolve();
        return Promise.all([loadImage(jar.getAttribute('data-front')), loadImage(jar.getAttribute('data-back'))]).then(function (pair) {
          frontImg = solidJar(pair[0]);
          backImg = solidJar(pair[1]);
          frontImg.bounds = measureJar(frontImg);
          backImg.bounds = measureJar(backImg);
        });
      }

      function makeShade(w) {
        var c = document.createElement('canvas');
        c.width = w;
        c.height = 1;
        var g = c.getContext('2d');
        var img = g.createImageData(w, 1);
        var d = img.data;
        for (var i = 0; i < w; i++) {
          var nx = ((i + 0.5) / w) * 2 - 1;
          var nz = Math.sqrt(Math.max(0, 1 - nx * nx));
          var v = Math.max(0, Math.min(255, (0.72 + 0.28 * nz) * 255));
          var p = i * 4;
          d[p] = v;
          d[p + 1] = v;
          d[p + 2] = Math.max(0, v - 10);
          d[p + 3] = 255;
        }
        g.putImageData(img, 0, 0);
        return c;
      }

      function makeSpec(w) {
        var c = document.createElement('canvas');
        c.width = w;
        c.height = 1;
        var g = c.getContext('2d');
        var img = g.createImageData(w, 1);
        var d = img.data;
        for (var i = 0; i < w; i++) {
          var nx = ((i + 0.5) / w) * 2 - 1;
          var nz = Math.sqrt(Math.max(0, 1 - nx * nx));
          var highlight = Math.exp(-Math.pow(nx + 0.28, 2) * 22);
          var rim = Math.pow(1 - nz, 2.6);
          var a = Math.max(0, Math.min(255, (highlight * 0.9 + rim * 0.4) * 255));
          var p = i * 4;
          d[p] = 255;
          d[p + 1] = 255;
          d[p + 2] = 255;
          d[p + 3] = a;
        }
        g.putImageData(img, 0, 0);
        return c;
      }

      function draw(angle) {
        var rect = photo.getBoundingClientRect();
        var dpr = Math.min(window.devicePixelRatio || 1, 2);
        var w = Math.max(1, Math.round(rect.width * dpr));
        var h = Math.max(1, Math.round(rect.height * dpr));
        if (canvas.width !== w || canvas.height !== h) {
          canvas.width = w;
          canvas.height = h;
          hold.width = w;
          hold.height = h;
          mask.width = w;
          mask.height = h;
          shade = makeShade(w);
          spec = makeSpec(w);
        }
        ctx.clearRect(0, 0, w, h);
        var fb = frontImg.bounds;
        var bb = backImg.bounds;
        var scaleX = w / frontImg.width;
        var scaleY = h / frontImg.height;
        var x0 = fb.minX * scaleX;
        var y0 = fb.minY * scaleY;
        var span = Math.max(1, (fb.maxX - fb.minX) * scaleX);
        var boxH = Math.max(1, (fb.maxY - fb.minY) * scaleY);
        var cols = Math.min(180, Math.round(span));
        var colW = span / cols;
        for (var i = 0; i < cols; i++) {
          var nx = ((i + 0.5) / cols) * 2 - 1;
          var alpha = Math.asin(nx) + angle;
          alpha = Math.atan2(Math.sin(alpha), Math.cos(alpha));
          var src;
          var box;
          var u;
          if (Math.abs(alpha) <= Math.PI / 2) {
            src = frontImg;
            box = fb;
            u = 0.5 + 0.5 * Math.sin(alpha);
          } else {
            src = backImg;
            box = bb;
            var beta = alpha > 0 ? alpha - Math.PI : alpha + Math.PI;
            u = 0.5 + 0.5 * Math.sin(beta);
          }
          var sampleX = box.minX + u * (box.maxX - box.minX);
          var sampleW = Math.max(1, (box.maxX - box.minX) / cols);
          ctx.drawImage(src, sampleX, box.minY, sampleW, Math.max(1, box.maxY - box.minY), x0 + i * colW, y0, colW + 0.6, boxH);
        }

        holdCtx.clearRect(0, 0, w, h);
        holdCtx.drawImage(canvas, 0, 0);

        maskCtx.globalCompositeOperation = 'source-over';
        maskCtx.clearRect(0, 0, w, h);
        maskCtx.drawImage(shade, 0, 0, w, h);
        maskCtx.globalCompositeOperation = 'destination-in';
        maskCtx.drawImage(hold, 0, 0);
        ctx.save();
        ctx.globalCompositeOperation = 'multiply';
        ctx.drawImage(mask, 0, 0);
        ctx.restore();

        maskCtx.globalCompositeOperation = 'source-over';
        maskCtx.clearRect(0, 0, w, h);
        maskCtx.drawImage(spec, 0, 0, w, h);
        maskCtx.globalCompositeOperation = 'destination-in';
        maskCtx.drawImage(hold, 0, 0);
        ctx.save();
        ctx.globalCompositeOperation = 'screen';
        ctx.drawImage(mask, 0, 0);
        ctx.restore();

        holdCtx.clearRect(0, 0, w, h);
        holdCtx.drawImage(canvas, 0, 0);
        ctx.clearRect(0, 0, w, h);
        ctx.save();
        ctx.globalCompositeOperation = 'lighter';
        var spread = Math.max(2, span * 0.055);
        var smear = [-2, -1, 0, 1, 2];
        var weight = [0.12, 0.2, 0.36, 0.2, 0.12];
        for (var s = 0; s < smear.length; s++) {
          ctx.globalAlpha = weight[s];
          ctx.drawImage(hold, smear[s] * spread, 0);
        }
        ctx.restore();
      }

      function stopSpin() {
        running = false;
        spin = 0;
        speed = 0;
        last = 0;
        window.cancelAnimationFrame(raf);
        jar.classList.remove('is-spinning');
        if (canvas.width) ctx.clearRect(0, 0, canvas.width, canvas.height);
        if (activeStop === stopSpin) activeStop = null;
      }

      function frame(now) {
        if (!running) return;
        var dt = last ? Math.min(34, now - last) : 16;
        last = now;
        speed += (turn - speed) * Math.min(1, dt / 120);
        spin += speed * (dt / 1000);
        draw(spin);
        raf = window.requestAnimationFrame(frame);
      }

      function beginSpin() {
        if (activeStop && activeStop !== stopSpin) activeStop();
        activeStop = stopSpin;
        running = true;
        loadPair().then(function () {
          if (!running || !frontImg) return;
          if (jar.classList.contains('is-spinning')) return;
          last = 0;
          jar.classList.add('is-spinning');
          raf = window.requestAnimationFrame(frame);
        });
      }

      if (canHover) {
        jar.parentNode.addEventListener('mouseenter', beginSpin);
        jar.parentNode.addEventListener('mouseleave', stopSpin);
      } else {
        var link = jar.closest('a');
        if (!link) return;
        link.addEventListener('click', function (event) {
          if (link.classList.contains('is-spun')) return;
          event.preventDefault();
          link.classList.add('is-spun');
          beginSpin();
          var stamp = {};
          link._dpSpin = stamp;
          window.setTimeout(function () {
            if (link._dpSpin === stamp) stopSpin();
          }, 1300);
        });
      }
    });

    function measureJar(image) {
      var w = image.width;
      var h = image.height;
      var c = document.createElement('canvas');
      c.width = w;
      c.height = h;
      var g = c.getContext('2d');
      g.drawImage(image, 0, 0);
      try {
        var d = g.getImageData(0, 0, w, h).data;
        var minX = w;
        var maxX = 0;
        var minY = h;
        var maxY = 0;
        for (var y = 0; y < h; y++) {
          for (var x = 0; x < w; x++) {
            if (d[(y * w + x) * 4 + 3] > 24) {
              if (x < minX) minX = x;
              if (x > maxX) maxX = x;
              if (y < minY) minY = y;
              if (y > maxY) maxY = y;
            }
          }
        }
        if (maxX <= minX || maxY <= minY) return { minX: 0, maxX: w - 1, minY: 0, maxY: h - 1 };
        return { minX: minX, maxX: maxX, minY: minY, maxY: maxY };
      } catch (e) {
        return { minX: 0, maxX: w - 1, minY: 0, maxY: h - 1 };
      }
    }

    function solidJar(image) {
      var c = document.createElement('canvas');
      c.width = image.naturalWidth || image.width;
      c.height = image.naturalHeight || image.height;
      var g = c.getContext('2d');
      g.drawImage(image, 0, 0);
      try {
        var frame = g.getImageData(0, 0, c.width, c.height);
        var d = frame.data;
        var w = c.width;
        var h = c.height;
        for (var y = 0; y < h; y++) {
          var min = -1;
          var max = -1;
          for (var x = 0; x < w; x++) {
            if (d[(y * w + x) * 4 + 3] > 24) {
              if (min < 0) min = x;
              max = x;
            }
          }
          if (min < 0) continue;
          var last = min;
          for (var x2 = min; x2 <= max; x2++) {
            var i = (y * w + x2) * 4;
            if (d[i + 3] > 24) {
              last = x2;
              continue;
            }
            var next = x2 + 1;
            while (next <= max && d[(y * w + next) * 4 + 3] <= 24) next++;
            var use = (next <= max && next - x2 < x2 - last) ? next : last;
            var s = (y * w + use) * 4;
            d[i] = d[s];
            d[i + 1] = d[s + 1];
            d[i + 2] = d[s + 2];
            d[i + 3] = 255;
          }
        }
        g.putImageData(frame, 0, 0);
        return c;
      } catch (e) {
        return image;
      }
    }

    function loadImage(src) {
      return new Promise(function (resolve) {
        var image = new Image();
        image.crossOrigin = 'anonymous';
        image.onload = function () { resolve(image); };
        image.onerror = function () {
          var fallback = new Image();
          fallback.onload = function () { resolve(fallback); };
          fallback.src = src;
        };
        image.src = src;
      });
    }
  })();
</script>
