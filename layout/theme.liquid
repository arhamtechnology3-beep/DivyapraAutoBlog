      {%- assign dp_seo_override = true -%}
      {%- assign dp_seo_title = 'Buy Authentic Gujarati Spices & Masala Online | Divyaprabha Foods' -%}
      {%- assign dp_seo_desc = 'Buy authentic homemade Gujarati spices and masala online. Pure, premium, traditional blends made with natural ingredients. FSSAI certified.' -%}
