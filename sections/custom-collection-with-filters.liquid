    { "type": "header", "content": "🏷️ Collection Header" },
    { "type": "checkbox", "id": "show_collection_banner", "label": "Show Collection Title/Banner", "default": true },
    { "type": "checkbox", "id": "show_collection_image", "label": "Use Collection Image as Banner", "default": true },
    { "type": "checkbox", "id": "show_collection_desc", "label": "Show Collection Description", "default": true },
    { "type": "range", "id": "banner_height", "label": "Banner Min Height (px)", "min": 80, "max": 360, "step": 10, "default": 180 },
    { "type": "range", "id": "banner_radius", "label": "Banner Border Radius (px)", "min": 0, "max": 24, "step": 2, "default": 8 },
    { "type": "range", "id": "banner_title_size", "label": "Banner Title Size (px)", "min": 16, "max": 56, "step": 2, "default": 28 },

    { "type": "header", "content": "🗺️ Breadcrumb" },
    { "type": "checkbox", "id": "show_breadcrumb", "label": "Show Breadcrumb", "default": true },
