                {%- unless badge_rendered -%}
                  <!-- Fallback to feature: tags or plain tags if no metafield specified or found -->
                  {%- assign filtered_tags = '' -%}
                  {%- for tag in product.tags -%}
                    {%- if tag contains 'feature:' -%}
                      {%- assign tag_label = tag | remove: 'feature:' | strip -%}
                      {%- assign filtered_tags = filtered_tags | append: tag_label | append: '|' -%}
                    {%- endif -%}
                  {%- endfor -%}

                  {%- if filtered_tags != '' -%}
