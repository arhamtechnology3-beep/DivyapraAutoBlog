                        {%- if tag_label != '' -%}
                          <span class="ccp-tag">{{ tag_label }}</span>
                        {%- endif -%}
                      {%- endfor -%}
                    </div>
                  {%- else -%}
                    {%- if product.tags.size > 0 -%}
                      <div class="ccp-tags" aria-label="Product tags">
                        {%- for tag in product.tags limit: 3 -%}
                          <span class="ccp-tag">{{ tag }}</span>
                        {%- endfor -%}
                      </div>
                    {%- endif -%}
                  {%- endif -%}
                {%- endunless -%}

                {%- comment -%} Bottom: variant + price + ATC {%- endcomment -%}
                <div class="ccp-bottom">

                  {%- if has_variants -%}
                    <select class="ccp-variant-select"
                      aria-label="Select variant for {{ product.title | escape }}"
                      data-product-handle="{{ product.handle }}"
                      data-product-id="{{ product.id }}"
                    >
                      {%- for variant in product.variants -%}
                        <option value="{{ variant.id }}"
                          data-price="{{ variant.price }}"
                          data-compare-price="{{ variant.compare_at_price }}"
                          data-available="{{ variant.available }}"
                          {%- if variant == current_variant %} selected{%- endif -%}
                        >
                          {{ variant.title }} - {{ variant.price | money }}
                          {%- if variant.compare_at_price > variant.price %} (MRP {{ variant.compare_at_price | money }}){%- endif -%}
                          {%- unless variant.available %} – Sold Out{%- endunless -%}
                        </option>
                      {%- endfor -%}
                    </select>
                  {%- endif -%}

                  <div class="ccp-price-wrap">
                    <span class="ccp-price" data-price-display data-raw-price="{{ current_variant.price }}"></span>
                    <span class="ccp-compare" data-compare-display data-raw-compare="{{ current_variant.compare_at_price }}"
                      {%- unless current_variant.compare_at_price > current_variant.price %} style="display:none;"{%- endunless -%}
                    ></span>
                  </div>

                  <div class="ccp-error-msg" role="alert" aria-live="polite" data-error-msg></div>

                  {%- if is_sold_out -%}
