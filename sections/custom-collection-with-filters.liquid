<script>
window.Shopify = window.Shopify || {};
window.Shopify.money_format = window.Shopify.money_format || {{ shop.money_format | json }};

(function() {
  'use strict';

  var ROOT = document.getElementById('ccp-{{ section.id }}');
  if (!ROOT) return;

  // ─── Money formatter (same as custom-product-grid) ──────────────────────
  function fmt(cents) {
    var amt = (cents / 100).toFixed(2).replace(/\.00$/, '');
    if (window.Shopify && window.Shopify.money_format) {
      return window.Shopify.money_format.replace(/\{\{\s*amount[^}]*\}\}/g, amt);
    }
    var sym = ROOT.getAttribute('data-currency') || '₹';
    return sym + amt;
  }

  // ─── Init prices on load ─────────────────────────────────────────────────
  function initPrices() {
    ROOT.querySelectorAll('.ccp-card').forEach(function(card) {
      var pe = card.querySelector('[data-price-display]');
      var ce = card.querySelector('[data-compare-display]');
      if (pe) {
        var rp = parseInt(pe.getAttribute('data-raw-price') || '0', 10);
        if (rp > 0) pe.textContent = fmt(rp);
      }
      if (ce) {
        var rc = parseInt(ce.getAttribute('data-raw-compare') || '0', 10);
        var rp2 = pe ? parseInt(pe.getAttribute('data-raw-price') || '0', 10) : 0;
        if (rc > rp2 && rc > 0) { ce.textContent = fmt(rc); ce.style.display = ''; }
        else { ce.style.display = 'none'; }
      }
    });
  }
  if (document.readyState === 'loading') { document.addEventListener('DOMContentLoaded', initPrices); }
  else { initPrices(); }

  // ─── Variant change ──────────────────────────────────────────────────────
  ROOT.addEventListener('change', function(e) {
    if (!e.target.classList.contains('ccp-variant-select')) return;
    var sel  = e.target;
    var card = sel.closest('.ccp-card');
    var opt  = sel.options[sel.selectedIndex];
    var price   = opt.getAttribute('data-price');
    var compare = opt.getAttribute('data-compare-price');
    var avail   = opt.getAttribute('data-available') === 'true';
    var vid     = opt.value;

    var pe  = card.querySelector('[data-price-display]');
    var ce  = card.querySelector('[data-compare-display]');
    var btn = card.querySelector('[data-atc-btn]');
    var err = card.querySelector('[data-error-msg]');

    if (pe && price) {
      pe.textContent = fmt(parseInt(price,10));
      pe.setAttribute('data-raw-price', price);
      card.setAttribute('data-price', (parseInt(price, 10) / 100).toString());
    }
    if (ce) {
      if (compare && parseInt(compare,10) > parseInt(price,10)) {
        ce.textContent = fmt(parseInt(compare,10)); ce.style.display = '';
        ce.setAttribute('data-raw-compare', compare);
        card.setAttribute('data-compare-price', (parseInt(compare, 10) / 100).toString());
      } else {
        ce.textContent = ''; ce.style.display = 'none';
        card.setAttribute('data-compare-price', '0');
      }
    }
    card.setAttribute('data-available', avail ? 'true' : 'false');
    var saleBadge = card.querySelector('.ccp-badge-sale:not(.ccp-badge-bestseller)');
    if (saleBadge) saleBadge.style.display = (compare && parseInt(compare,10) > parseInt(price,10)) ? '' : 'none';


    if (btn) {
      btn.setAttribute('data-variant-id', vid);
      if (!avail) {
        btn.disabled = true; btn.textContent = '{{ section.settings.unavailable_label | default: "Unavailable" }}';
        btn.classList.add('soldout-btn');
      } else {
        btn.disabled = false; btn.textContent = '{{ section.settings.atc_label | default: "Add to Cart" }}';
        btn.classList.remove('soldout-btn');
      }
    }
    if (err) err.textContent = '';
  });

  // ─── Add to Cart (opens sidebar cart — same logic as custom-product-grid) ─
  ROOT.addEventListener('click', function(e) {
    var btn = e.target.closest('[data-atc-btn]');
    if (!btn || btn.disabled) return;

    var card = btn.closest('.ccp-card');
    var vid  = btn.getAttribute('data-variant-id');
    var err  = card.querySelector('[data-error-msg]');

    if (!vid) { if (err) err.textContent = 'Please select a variant.'; return; }

    btn.disabled = true;
    btn.classList.add('loading');
    btn.textContent = '{{ section.settings.adding_label | default: "Adding..." }}';
    if (err) err.textContent = '';

    fetch('/cart/add.js', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json', 'X-Requested-With': 'XMLHttpRequest' },
      body: JSON.stringify({ id: parseInt(vid, 10), quantity: 1, sections: 'minicart', sections_url: window.location.pathname })
    })
    .then(function(r) {
      if (!r.ok) return r.json().then(function(d) { throw new Error(d.description || 'Error adding to cart.'); });
      return r.json();
    })
    .then(function(data) {
      btn.classList.remove('loading');
      btn.classList.add('success');
      btn.textContent = '{{ section.settings.added_label | default: "Added ✓" }}';

      if (data.sections && data.sections['minicart']) {
        injectAndOpenCart(data.sections['minicart']);
      } else {
        openSidebarCart();
      }

      setTimeout(function() {
        btn.classList.remove('success');
        btn.textContent = '{{ section.settings.atc_label | default: "Add to Cart" }}';
        btn.disabled = false;
      }, 2500);
    })
    .catch(function(ex) {
      btn.classList.remove('loading');
      btn.textContent = '{{ section.settings.atc_label | default: "Add to Cart" }}';
      btn.disabled = false;
      if (err) err.textContent = ex.message || 'Could not add to cart.';
    });
  });

  // ─── Inject mini-cart HTML + open drawer (IDENTICAL to homepage section) ─
  function injectAndOpenCart(html) {
    var popup = document.getElementById('js_cart_popup');
    if (!popup) { openSidebarCart(); return; }
    var parser  = new DOMParser();
    var doc     = parser.parseFromString(html, 'text/html');
    var newSec  = doc.querySelector('[id^="shopify-section"], .shopify-section');
    var oldSec  = popup.querySelector('[id^="shopify-section"]');
    if (newSec && oldSec) oldSec.innerHTML = newSec.innerHTML;
    else if (newSec) popup.innerHTML = newSec.outerHTML;
    updateCartCount();
    popup.classList.add('act_opened');
    document.body.classList.add('js_cart_popup_open');
  }

  function updateCartCount() {
    fetch('/cart.js').then(function(r) { return r.json(); }).then(function(c) {
      document.querySelectorAll(
        '[data-cart-count],[data-cart-item-count],.cart-count,.cart__count,' +
        '.header__cart-count,.js-cart-count,.cart-count-bubble'
      ).forEach(function(el) { el.textContent = c.item_count; if (c.item_count > 0) el.removeAttribute('hidden'); });
    }).catch(function(){});
  }

  function openSidebarCart() {
    // PRIMARY: Cosmetics theme #js_cart_popup
    var popup = document.getElementById('js_cart_popup');
    if (popup) {
      fetch('/?sections=minicart')
        .then(function(r) { return r.ok ? r.json() : Promise.reject(); })
        .then(function(j) {
          if (j && j['minicart']) {
            var parser = new DOMParser();
            var doc    = parser.parseFromString(j['minicart'], 'text/html');
            var ns     = doc.querySelector('[id^="shopify-section"], .shopify-section');
            var os     = popup.querySelector('[id^="shopify-section"]');
            if (ns && os) os.innerHTML = ns.innerHTML;
          }
        }).catch(function(){}).finally(function() {
          updateCartCount();
          popup.classList.add('act_opened');
          document.body.classList.add('js_cart_popup_open');
        });
      return;
    }
    // Fallback for other themes
    fetch('/cart.js').then(function(r){return r.json();}).then(function(c){
      document.querySelectorAll('[data-cart-count],[data-cart-item-count],.cart-count,.cart__count,.header__cart-count,.js-cart-count,.cart-count-bubble').forEach(function(el){el.textContent=c.item_count;if(c.item_count>0)el.removeAttribute('hidden');});
      document.dispatchEvent(new CustomEvent('cart:updated',{detail:{cart:c},bubbles:true}));
    }).catch(function(){});
    var drawers = ['#cart-drawer','cart-drawer','[id*="CartDrawer"]','[id*="cart-drawer"]','[data-drawer="cart"]','.cart-drawer','#sidebar-cart','.sidebar-cart','#mini-cart','.mini-cart','.ajax-cart','[id*="mini-cart"]','[id*="MiniCart"]','.drawer--cart','[data-cart-drawer]'];
    var d = null;
    for (var i=0;i<drawers.length;i++){d=document.querySelector(drawers[i]);if(d)break;}
    if(d){['is-open','active','open','is-active','visible','shown'].forEach(function(c){d.classList.add(c);});d.removeAttribute('hidden');}
    ['cart:open','cart:refresh','cart:updated','cart-drawer:open','drawer:open:cart','theme:cart:open'].forEach(function(ev){document.dispatchEvent(new CustomEvent(ev,{bubbles:true}));window.dispatchEvent(new CustomEvent(ev,{bubbles:true}));});
    if(window.theme){if(window.theme.cart&&typeof window.theme.cart.open==='function')window.theme.cart.open();if(window.theme.drawer&&typeof window.theme.drawer.open==='function')window.theme.drawer.open('cart');}
    document.body.classList.add('js-drawer-open','js-drawer-open-cart','cart-open','drawer-open');
  }

  // ─── COLLECTION CONTROLLER ───────────────────────────────────────────────
  window['CCPc_{{ section.id }}'] = {

    doSort: function(val) {
      var grid = document.getElementById('ccpGrid');
      if (!grid) return;
      var cards = Array.prototype.slice.call(grid.querySelectorAll('.ccp-card'));
      cards.sort(function(a, b) {
        var aPrice = parseFloat(a.getAttribute('data-price') || '0');
        var bPrice = parseFloat(b.getAttribute('data-price') || '0');
        var aTitle = (a.getAttribute('data-title') || '').trim().toLowerCase();
        var bTitle = (b.getAttribute('data-title') || '').trim().toLowerCase();
        var aDate = parseInt(a.getAttribute('data-created-at') || '0', 10);
        var bDate = parseInt(b.getAttribute('data-created-at') || '0', 10);
        var aIdx = parseInt(a.getAttribute('data-original-index') || '0', 10);
        var bIdx = parseInt(b.getAttribute('data-original-index') || '0', 10);

        if (val === 'price-ascending') {
          return aPrice - bPrice;
        } else if (val === 'price-descending') {
          return bPrice - aPrice;
        } else if (val === 'title-ascending') {
          return aTitle.localeCompare(bTitle);
        } else if (val === 'title-descending') {
          return bTitle.localeCompare(aTitle);
        } else if (val === 'created-ascending') {
          return aDate - bDate;
        } else if (val === 'created-descending') {
          return bDate - aDate;
        } else {
          return aIdx - bIdx;
        }
      });
      cards.forEach(function(card) {
        grid.appendChild(card);
      });
      var pag = grid.querySelector('.ccp-pagination');
      if (pag) {
        grid.appendChild(pag);
      }
      var u = new URL(window.location.href);
      u.searchParams.set('sort_by', val);
      history.replaceState(null, '', u.toString());
    },

    setGrid: function(cols, btn) {
      var grid = document.getElementById('ccpGrid');
      if (grid) grid.setAttribute('data-cols', cols);
      ROOT.querySelectorAll('.ccp-grid-btn').forEach(function(b){ b.classList.remove('active'); });
      if (btn) btn.classList.add('active');
    },

    toggleGroup: function(id) {
      var body   = document.getElementById('ccpFgBody-' + id);
      var header = body && body.previousElementSibling;
      if (!body) return;
      var closed = body.classList.toggle('ccp-closed');
      if (header) header.setAttribute('aria-expanded', !closed);
    },

    applyFilters: function() {
      var priceMinInp = ROOT.querySelector('[id^="prMin-"]');
      var priceMaxInp = ROOT.querySelector('[id^="prMax-"]');
      var minPrice = priceMinInp && priceMinInp.value ? parseFloat(priceMinInp.value) : 0;
      var maxPrice = priceMaxInp && priceMaxInp.value ? parseFloat(priceMaxInp.value) : Infinity;

      var activeMetafieldFilters = {};
      ROOT.querySelectorAll('.ccp-f-checkbox:checked').forEach(function(cb) {
        var key = cb.name.replace('filter.p.m.', '').replace(/\./g, '-');
        if (!activeMetafieldFilters[key]) {
          activeMetafieldFilters[key] = [];
        }
        activeMetafieldFilters[key].push(cb.value.toLowerCase().trim());
      });

      var cards = ROOT.querySelectorAll('#ccpGrid .ccp-card');
      cards.forEach(function(card) {
        var match = true;
        var cardPrice = parseFloat(card.getAttribute('data-price') || '0');
        if (cardPrice < minPrice || cardPrice > maxPrice) {
          match = false;
        }
        if (match) {
          for (var filterKey in activeMetafieldFilters) {
            var checkedVals = activeMetafieldFilters[filterKey];
            if (checkedVals.length > 0) {
              var attrName = 'data-mf-' + filterKey;
              var cardAttr = card.getAttribute(attrName);
              if (!cardAttr) {
                match = false;
                break;
              }
              var cardVals = cardAttr.split('|').map(function(v) { return v.toLowerCase().trim(); });
              var overlap = checkedVals.some(function(val) {
                return cardVals.indexOf(val) !== -1;
              });
              if (!overlap) {
                match = false;
                break;
              }
            }
          }
        }
        if (match) {
          card.style.display = '';
        } else {
          card.style.display = 'none';
        }
      });

      var visibleCards = ROOT.querySelectorAll('#ccpGrid .ccp-card:not([style*="display: none"])');
      var countEl = ROOT.querySelector('.ccp-prod-count');
      if (countEl) {
        var labelUnit = countEl.getAttribute('data-unit') || '{{ section.settings.products_label | default: "products" }}';
        countEl.textContent = visibleCards.length + ' ' + labelUnit;
      }

      var fallback = ROOT.querySelector('.ccp-no-products-fallback');
      if (fallback) {
        fallback.style.display = visibleCards.length === 0 ? 'block' : 'none';
      }

      // Sync active tags
      var cartSymbol = ROOT.getAttribute('data-currency') || '₹';
      var activeTags = [];
      var count = 0;
      if (priceMinInp && priceMinInp.value) {
        activeTags.push({ type: 'price-min', key: priceMinInp.name, val: 'Min: ' + cartSymbol + priceMinInp.value });
        count++;
      }
      if (priceMaxInp && priceMaxInp.value) {
        activeTags.push({ type: 'price-max', key: priceMaxInp.name, val: 'Max: ' + cartSymbol + priceMaxInp.value });
        count++;
      }
      ROOT.querySelectorAll('.ccp-f-checkbox:checked').forEach(function(cb) {
        activeTags.push({ type: 'metafield', key: cb.name, val: cb.value, checkbox: cb });
        count++;
      });

      var pill = document.getElementById('ccpActivePill');
      if (pill) {
        if (count > 0) {
          pill.textContent = count;
          pill.style.display = 'inline-flex';
        } else {
          pill.style.display = 'none';
        }
      }
      var clearBtn = document.getElementById('ccpClearAll');
      if (clearBtn) {
        clearBtn.style.display = count > 0 ? 'inline-block' : 'none';
      }

      var tagsEl = document.getElementById('ccpActiveTags');
      if (tagsEl) {
        tagsEl.innerHTML = '';
        activeTags.forEach(function(t) {
          var btn = document.createElement('button');
          btn.className = 'ccp-active-tag';
          btn.innerHTML = t.val + ' <span aria-hidden="true">✕</span>';
          btn.setAttribute('aria-label', 'Remove filter: ' + t.val);
          btn.onclick = function() {
            if (t.type === 'price-min') {
              priceMinInp.value = '';
              var sliderMin = ROOT.querySelector('.ccp-range-input[min]');
              if (sliderMin) { sliderMin.value = 0; }
              var filterId = priceMinInp.id.replace('prMin-', '');
              window['CCPc_{{ section.id }}']._updateFill(filterId);
            } else if (t.type === 'price-max') {
              priceMaxInp.value = '';
              var sliderMax = ROOT.querySelector('.ccp-range-input[max]');
              if (sliderMax) { sliderMax.value = sliderMax.max; }
              var filterId = priceMaxInp.id.replace('prMax-', '');
              window['CCPc_{{ section.id }}']._updateFill(filterId);
            } else if (t.type === 'metafield') {
              t.checkbox.checked = false;
            }
            window['CCPc_{{ section.id }}'].applyFilters();
          };
          tagsEl.appendChild(btn);
        });
      }

      // Sync URL parameter state without reload
      var u = new URL(window.location.href);
      var toDelete = [];
      u.searchParams.forEach(function(_, k){ if(k.startsWith('filter.')) toDelete.push(k); });
      toDelete.forEach(function(k){ u.searchParams.delete(k); });
      ROOT.querySelectorAll('.ccp-f-checkbox:checked').forEach(function(cb){
        u.searchParams.append(cb.name, cb.value);
      });
      if (priceMinInp && priceMinInp.value) {
        u.searchParams.set(priceMinInp.name, priceMinInp.value);
      }
      if (priceMaxInp && priceMaxInp.value) {
        u.searchParams.set(priceMaxInp.name, priceMaxInp.value);
      }
      u.searchParams.delete('page');
      history.replaceState(null, '', u.toString());
    },

    clearAll: function() {
      ROOT.querySelectorAll('.ccp-f-checkbox').forEach(function(cb){ cb.checked = false; });
      var priceMinInp = ROOT.querySelector('[id^="prMin-"]');
      var priceMaxInp = ROOT.querySelector('[id^="prMax-"]');
      if (priceMinInp) priceMinInp.value = '';
      if (priceMaxInp) priceMaxInp.value = '';

      var sliders = ROOT.querySelectorAll('.ccp-range-input');
      if (sliders.length > 0) sliders[0].value = 0;
      if (sliders.length > 1) sliders[1].value = sliders[1].max;

      // Update fills
      var priceTrack = ROOT.querySelector('.ccp-slider-track');
      if (priceTrack) {
        var filterId = priceTrack.id.replace('sliderTrack-', '');
        this._updateFill(filterId);
      }

      this.applyFilters();
    },

    syncSlider: function(range, type, filterId) {
      var inp = document.getElementById('pr' + (type === 'min' ? 'Min' : 'Max') + '-' + filterId);
      if (inp) inp.value = range.value;
      this._updateFill(filterId);
    },

    _updateFill: function(id) {
      var track = document.getElementById('sliderTrack-' + id);
      if (!track) return;
      var ranges = track.querySelectorAll('.ccp-range-input');
      var fill   = document.getElementById('sliderFill-' + id);
      if (!fill || ranges.length < 2) return;
      var mn = parseFloat(ranges[0].min), mx = parseFloat(ranges[0].max);
      var vmin = parseFloat(ranges[0].value), vmax = parseFloat(ranges[1].value);
      fill.style.left  = ((vmin - mn) / (mx - mn) * 100) + '%';
      fill.style.right = (100 - (vmax - mn) / (mx - mn) * 100) + '%';
    },

    openSidebar: function() {
      var sb = document.getElementById('ccpSidebar');
      var ov = document.getElementById('ccpOverlay');
      if (sb) { sb.classList.add('open'); document.body.style.overflow = 'hidden'; }
      if (ov) ov.classList.add('open');
      var tog = document.getElementById('ccpFilterOpen');
      if (tog) tog.setAttribute('aria-expanded', 'true');
    },

    closeSidebar: function() {
      var sb = document.getElementById('ccpSidebar');
      var ov = document.getElementById('ccpOverlay');
      if (sb) { sb.classList.remove('open'); document.body.style.overflow = ''; }
      if (ov) ov.classList.remove('open');
      var tog = document.getElementById('ccpFilterOpen');
      if (tog) tog.setAttribute('aria-expanded', 'false');
    },

    _syncActiveFromURL: function() {
      var u = new URL(window.location.href);

      // Reset checkboxes
      ROOT.querySelectorAll('.ccp-f-checkbox').forEach(function(cb){ cb.checked = false; });

      // Reset price fields
      var priceMinInp = ROOT.querySelector('[id^="prMin-"]');
      var priceMaxInp = ROOT.querySelector('[id^="prMax-"]');
      if (priceMinInp) priceMinInp.value = '';
      if (priceMaxInp) priceMaxInp.value = '';

      u.searchParams.forEach(function(val, key) {
        if (!key.startsWith('filter.')) return;
        if (key.includes('price.gte')) {
          if (priceMinInp) {
            priceMinInp.value = val;
            var filterId = priceMinInp.id.replace('prMin-', '');
            var sliders = ROOT.querySelectorAll('.ccp-range-input');
            if (sliders.length > 0) {
              sliders[0].value = val;
              window['CCPc_{{ section.id }}']._updateFill(filterId);
            }
          }
        } else if (key.includes('price.lte')) {
          if (priceMaxInp) {
            priceMaxInp.value = val;
            var filterId = priceMaxInp.id.replace('prMax-', '');
            var sliders = ROOT.querySelectorAll('.ccp-range-input');
            if (sliders.length > 1) {
              sliders[1].value = val;
              window['CCPc_{{ section.id }}']._updateFill(filterId);
            }
          }
        } else {
          ROOT.querySelectorAll('.ccp-f-checkbox[name="' + key + '"][value="' + val + '"]').forEach(function(cb){ cb.checked = true; });
        }
      });

      this.applyFilters();

      var sortVal = u.searchParams.get('sort_by');
      if (sortVal) {
        var sortSelect = document.getElementById('ccpSort');
        if (sortSelect) {
          sortSelect.value = sortVal;
          this.doSort(sortVal);
        }
      }
    },

    init: function() {
      var self = this;
      this._syncActiveFromURL();
      var open  = document.getElementById('ccpFilterOpen');
      var close = document.getElementById('ccpSidebarClose');
      if (open)  open.addEventListener('click',  function(){ self.openSidebar(); });
      if (close) close.addEventListener('click', function(){ self.closeSidebar(); });
    }
  };

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', function(){ window['CCPc_{{ section.id }}'].init(); });
  } else {
    window['CCPc_{{ section.id }}'].init();
  }

})();
</script>

