{%- liquid
  assign sid = section.id
  assign sett_equal = section.settings.use_eq_height
  assign ck = section.settings.use_eq_height
  assign url = section.settings.button_link
  assign auto_festival = section.settings.auto_festival_countdown
  if auto_festival == nil
    assign auto_festival = true
  endif

  assign cd_year = section.settings.year_count_down | plus: 0
  assign cd_month = section.settings.month_count_down | plus: 0
  assign cd_day = section.settings.day_count_down | plus: 0
  assign banner_subtitle = section.settings.subtitle
-%}

{%- if auto_festival -%}
  {%- comment -%} include (not render) so festival assigns are visible in this section {%- endcomment -%}
  {%- include 'dp-next-festival' -%}
  {%- if dp_festival_found -%}
    {%- assign cd_year = dp_festival_y | plus: 0 -%}
    {%- assign cd_month = dp_festival_m | plus: 0 -%}
    {%- assign cd_day = dp_festival_d | plus: 0 -%}
    {%- assign banner_subtitle = dp_festival_label -%}
  {%- endif -%}
{%- endif -%}

{%- liquid
  assign show_countdown = false
  if cd_year > 0 and cd_month > 0 and cd_day > 0
    assign cd_end = cd_year | append: '-' | append: cd_month | append: '-' | append: cd_day | append: ' 23:59:59'
    assign cd_end_s = cd_end | date: '%s' | plus: 0
    assign now_s = 'now' | date: '%s' | plus: 0
    if cd_end_s > now_s
      assign show_countdown = true
    endif
  endif
  if show_countdown
    assign copy_col = 'col-12 col-md-6 col-lg-6'
  else
    assign copy_col = 'col-12'
  endif
-%}

{%- for i in (1..1) -%}
  <section id="laber_{{sid}}" class="laber_product-countdown-banner_{{sid}}" data-dp-festival="{% if auto_festival and dp_festival_found %}{{ dp_festival_name | escape }}{% endif %}">
    <div class="container">
      <div class="laber_countdown_banner">
        <div class="row align-items-center">
          {%- assign url = section.settings.button_link -%}
          <div class="product_count_down {{ copy_col }}">
            <div class="content-countdown">
              <div class="product-inner">
                {% if section.settings.title != blank or banner_subtitle != blank %}
                  <div class="wrap_title m-lg-0">
                    {% if banner_subtitle != blank %}
                      <p class="subtitles mb-2">
                        {{ banner_subtitle }}
                      </p>
                    {% endif %}
                    {% if section.settings.title != blank %}
                      <h5 class="title1">
                        {% if section.settings.title_span_text != blank %}
                          <span style="color: {{ section.settings.title_span_color }}">{{ section.settings.title_span_text }}</span>
                        {% endif %}
                        {{ section.settings.title }}
                      </h5>
                    {% endif %}
                    {% if section.settings.btn != blank %}
                      <div class="laber_button mt-3 mt-lg-4">
                        <a
                          class="button"
                          href="{%- if url != blank -%}{{ url | replace: 'shopify://', '' }}{%- else -%}#{% endif %}"
                          onMouseOver="this.style.backgroundColor='{{section.settings.bg_cl_hover}}'; this.style.color='{{section.settings.cl_btn_hover}}'"
                          onMouseOut="this.style.backgroundColor='{{section.settings.bg_cl}}'; this.style.color='{{section.settings.cl_btn}}'"
                          style="color:{{section.settings.cl_btn}}; background-color:{{section.settings.bg_cl}};">
                          {{ section.settings.btn }}
                        </a>
                      </div>
                    {% endif %}
                  </div>
                {% endif %}

              </div>
            </div>
          </div>
          {%- if show_countdown -%}
          <div class="product_count_down col-12 col-md-6 col-lg-6">
            <div class="content-countdown">
              <div class="alo-countdown  text-center text-lg-end">
                  <div
                    class="cms-countdown"
                    data-y="{{ cd_year }}"
                    data-m="{{ cd_month }}"
                    data-d="{{ cd_day }}"
                    data-h="00"
                    data-i="00"
                    data-s="00"></div>
              </div>
            </div>
          </div>
          {%- endif -%}
        </div>
      </div>
    </div>
  </section>
{%- endfor -%}
{%- render 'section_style' -%}
{%- schema -%}
  {
    "name": "Bannner countdown",
    "class": "cms_section type_product_countdown_banner",
    "settings": [
      {
        "type": "header",
        "content": "== Product Settings"
      },
      {
        "type": "image_picker",
        "id": "bg_image",
        "label": "Background image",
        "info": "1920x700.jpg recommended"
      },
      {
        "type": "color",
        "id": "cl_bg",
        "label": "Background color",
        "default": "#fff"
      },
      {
        "type": "checkbox",
        "id": "auto_festival_countdown",
        "label": "Auto set date from next festival",
        "default": true,
        "info": "Uses the next Indian festival (Diwali, Holi, Navratri, etc.) as the countdown end. Subtitle becomes \"{Festival} Sale\"."
      },
      {
        "type": "text",
        "id": "subtitle",
        "label": "Subtitle (manual)",
        "info": "Used only when Auto festival is off"
      }, {
        "type": "text",
        "id": "year_count_down",
        "label": "Year of countdown (manual)",
        "default": "2021",
        "info": "Ignored when Auto festival is on"
      }, {
        "type": "text",
        "id": "month_count_down",
        "label": "Month of countdown (manual)",
        "default": "12"
      }, {
        "type": "text",
        "id": "day_count_down",
        "label": "Day of countdown (manual)",
        "default": "30"
      }, {
        "type": "text",
        "id": "btn",
        "label": "Button Text",
        "default": "Shop Now"
      }, {
        "type": "url",
        "id": "button_link",
        "label": "Button link"
      }, {
        "type": "header",
        "content": "== Style Button"
      }, {
        "type": "color",
        "id": "cl_btn",
        "label": "Button color ",
        "default": "#fff"
      }, {
        "type": "color",
        "id": "cl_btn_hover",
        "label": "Button color (hover)",
        "default": "#fff"
      }, {
        "type": "color",
        "id": "bg_cl",
        "label": "Button background color",
        "default": "#1a73e8"
      }, {
        "type": "color",
        "id": "bg_cl_hover",
        "label": "Button background color (hover)",
        "default": "#343e45"
      }, {
        "type": "header",
        "content": "== General Settings"
      }, {
        "type": "text",
        "id": "title",
        "label": "Heading",
        "default": "Special Offers"
      }, {
        "type": "text",
        "id": "title_span_text",
        "label": "Span Text",
        "default": "50% Off "
      }, {
        "type": "color",
        "id": "title_span_color",
        "label": "Span Text Color",
        "default": "#F3F0FA"
      }, {
        "type": "text",
        "id": "mg",
        "label": "Margin",
        "info": "Margin top, margin right, margin bottom, margin left. If you not use to blank"
      }, {
        "type": "text",
        "id": "pd",
        "label": "Padding",
        "info": "Padding top, padding right, padding bottom, padding left. If you not use to blank"
      }, {
        "type": "header",
        "content": "== Design Mobile Options"
      }, {
        "type": "text",
        "id": "mg_mb",
        "label": "Margin"
      }, {
        "type": "text",
        "id": "pd_mb",
        "label": "Padding"
      }
    ],
    "presets": [
      {
        "name": "Bannner countdown",
        "category": "Countdown"
      }
    ]
  }
{% endschema %}
