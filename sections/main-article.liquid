  .dp-translate-widget { display: inline-flex; align-items: center; gap: 6px; background: #ffffff; border: 1px solid #e8d5c0; padding: 4px 12px; border-radius: 30px; margin-left: auto; box-shadow: 0 2px 8px rgba(61,31,15,0.04); }
