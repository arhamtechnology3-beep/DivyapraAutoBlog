  .sidebar .dp-product-mini-card__img img, .dp-sticky-sidebar-wrapper .dp-product-mini-card__img img { width: 76px !important; min-width: 76px !important; max-width: 76px !important; height: 76px !important; min-height: 76px !important; max-height: 76px !important; object-fit: cover !important; display: block !important; margin: 0 !important; float: none !important; }
