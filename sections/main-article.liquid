{% stylesheet %}
/* --- RESPONSIVE FIXES FOR ARTICLE PAGE --- */
.sidebar .dp-sidebar-products-list,
.dp-sticky-sidebar-wrapper .dp-sidebar-products-list {
  display: flex !important;
  flex-direction: column !important;
  gap: 14px !important;
}

.sidebar .dp-product-mini-card,
.dp-sticky-sidebar-wrapper .dp-product-mini-card {
  display: flex !important;
  flex-direction: row !important;
  flex-wrap: nowrap !important;
  align-items: center !important;
  justify-content: flex-start !important;
  gap: 12px !important;
  background: #ffffff !important;
  border: 1px solid #e8d5c0 !important;
  border-radius: 14px !important;
  padding: 10px !important;
  box-shadow: 0 4px 12px rgba(61, 31, 15, 0.03) !important;
  box-sizing: border-box !important;
  width: 100% !important;
  max-width: 100% !important;
}

.sidebar .dp-product-mini-card__img,
.dp-sticky-sidebar-wrapper .dp-product-mini-card__img {
  position: relative !important;
  width: 76px !important;
  min-width: 76px !important;
  max-width: 76px !important;
  height: 76px !important;
  min-height: 76px !important;
  max-height: 76px !important;
  flex: 0 0 76px !important;
  border-radius: 10px !important;
  overflow: hidden !important;
  background: #fdf6ed !important;
  border: 1px solid #e8d5c0 !important;
  margin: 0 !important;
  float: none !important;
}

.sidebar .dp-product-mini-card__img a,
.dp-sticky-sidebar-wrapper .dp-product-mini-card__img a {
  display: block !important;
  width: 100% !important;
  height: 100% !important;
}

.sidebar .dp-product-mini-card__img img,
.dp-sticky-sidebar-wrapper .dp-product-mini-card__img img {
  width: 76px !important;
  min-width: 76px !important;
  max-width: 76px !important;
  height: 76px !important;
  min-height: 76px !important;
  max-height: 76px !important;
  object-fit: cover !important;
  display: block !important;
  margin: 0 !important;
}

.sidebar .dp-product-mini-card__info,
.dp-sticky-sidebar-wrapper .dp-product-mini-card__info {
  display: flex !important;
  flex-direction: column !important;
  justify-content: center !important;
  gap: 3px !important;
  flex: 1 1 auto !important;
  min-width: 0 !important;
  width: calc(100% - 88px) !important;
  text-align: left !important;
}

.single-blog {
  padding-top: clamp(20px, 3vw, 40px);
  padding-bottom: 60px;
  overflow-x: hidden;
}

.single-blog h1,
.single-blog h2,
.single-blog h3,
.single-blog h4,
.single-blog h5,
.single-blog h6 {
  scroll-margin-top: 130px;
  word-break: break-word;
  overflow-wrap: break-word;
}

.single-blog .article-title .h2,
.single-blog h1 {
  font-size: clamp(24px, 4.5vw, 36px) !important;
  line-height: 1.28 !important;
  font-weight: 800 !important;
  color: #3d1f0f !important;
  margin: 16px 0 !important;
  display: block !important;
}

.single-blog h2,
.main-info-post h2 {
  font-size: clamp(20px, 3vw, 26px) !important;
  line-height: 1.35 !important;
  font-weight: 800 !important;
  color: #3d1f0f !important;
  margin: 36px 0 16px !important;
}

.single-blog h3,
.main-info-post h3 {
  font-size: clamp(18px, 2.5vw, 22px) !important;
  line-height: 1.35 !important;
  font-weight: 800 !important;
  color: #3d1f0f !important;
  margin: 28px 0 14px !important;
}

.single-blog p,
.main-info-post p {
  font-size: 16px !important;
  line-height: 1.75 !important;
  color: #2d1206 !important;
  margin-bottom: 20px !important;
}

.single-blog .post-item .post-info img,
.single-blog .main-info-post img {
  max-width: 100% !important;
  height: auto !important;
  border-radius: 16px !important;
  margin: 24px auto !important;
  display: block !important;
}

.dp-cta-box img,
.single-blog .dp-cta-box img,
.main-info-post .dp-cta-box img {
  width: 130px !important;
  min-width: 130px !important;
  max-width: 130px !important;
  height: 130px !important;
  min-height: 130px !important;
  max-height: 130px !important;
  object-fit: cover !important;
  margin: 0 !important;
  display: block !important;
  border-radius: 14px !important;
  flex: 0 0 130px !important;
}
  display: block;
  margin: 20px auto;
}

.single-blog iframe,
.single-blog video {
  max-width: 100% !important;
  border-radius: 16px;
}

.single-blog ul,
.single-blog ol {
  padding-left: 20px;
  margin-bottom: 24px;
}

.single-blog li {
  margin-bottom: 8px;
  line-height: 1.6;
}

@media (max-width: 767px) {
  .single-blog .banner-img-article {
    border-radius: 12px;
    overflow: hidden;
  }
  .single-blog .content-blog {
    padding: 0 5px;
  }
  .single-blog .wrap-date {
    flex-wrap: wrap;
  }
}
