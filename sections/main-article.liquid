  .sidebar .dp-product-mini-card__info h4, .dp-sticky-sidebar-wrapper .dp-product-mini-card__info h4 { font-size: 13.5px !important; font-weight: 800 !important; margin: 0 !important; line-height: 1.35 !important; }
