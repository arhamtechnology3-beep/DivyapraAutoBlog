  .dp-audio-play-btn { width: 48px; height: 48px; min-width: 48px; border-radius: 50%; background: #b01215; color: #ffffff; border: none; display: flex; align-items: center; justify-content: center; cursor: pointer; box-shadow: 0 4px 12px rgba(176,18,21,0.3); transition: all 0.22s ease; flex-shrink: 0; }
