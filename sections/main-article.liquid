{% assign id = section.id %}
{% render 'article-json-ld' %}
{% assign chk_sidebar = true %}
{% assign show_tags = section.settings.show_tags %}
{% assign show_social = section.settings.show_social %}
{% assign limit_tags = section.settings.limit_tags | plus: 0 %}
{% assign layout = 3 %}
<div id="laber_{{id}}" class=" main-content shop-page main-content-blog single-blog right">
  <div class=" container">
    <div class="row">
      <div class="mobile-content col-xs-12 col-sm-12 col-md-9 col-lg-9 content-offset-right">
        <div class="banner-img-article">
          <a href="{{ article.url}}" title="{{ article.title }}">
            <div
              class="pr_lazy_img lazyload item__position img-article"
              data-bgset="{{ article.image.src | img_url: '1920x' }}"
              data-ratio="{{article.image.aspect_ratio}}"
              data-sizes="auto"
              style="padding-top:{{ 1 | divided_by: article.image.aspect_ratio | times: 100}}%;"></div>
          </a>
        </div>
        <div class="content-blog">
          <div class="head head-article">
            <div class="wrap-date mt-lg-4 mb-lg-4 mb-3">
              <div class="d-flex align-items-center gap-2">
                <div class="inner-date">
                  <span class="month">{{ article.created_at | date: '%B' }}</span>,
                  <span class="day">{{ article.created_at | date: '%d' }}</span>
                  <span class="year">{{ article.created_at | date: '%Y' }}</span>
                </div>
              </div>
              <ul class="meta-post">
                <li class="author">
                  {{ 'blogs.article.by_author' | t }}
                  {{ article.author }}
                </li>
              </ul>
              <!-- GOOGLE TRANSLATE WIDGET -->
              <div class="dp-translate-widget" style="margin-left: auto;">
                <span class="dp-translate-title">🌐 Translate Article:</span>
                <div id="google_translate_element"></div>
              </div>
              <script type="text/javascript">
                function googleTranslateElementInit() {
                  new google.translate.TranslateElement({
                    pageLanguage: 'en',
                    includedLanguages: 'gu,hi,mr,ta,te,kn,ml,bn,pa,en,es,fr,de,ar',
                    layout: google.translate.TranslateElement.InlineLayout.SIMPLE,
                    autoDisplay: false
                  }, 'google_translate_element');
                }
              </script>
              <script type="text/javascript" src="//translate.google.com/translate_a/element.js?cb=googleTranslateElementInit"></script>
            </div>
            {%- assign dp_article_display_title = article.title -%}
            {%- if article.handle == 'gorkeri-pickle-health' -%}
              {%- assign dp_article_display_title = 'Gor Keri Meaning: Sweet Jaggery Mango Pickle' -%}
            {%- elsif article.handle == 'top-10-homemade-pickles-in-india' -%}
              {%- assign dp_article_display_title = 'Top 10 Homemade Pickles in India' -%}
            {%- elsif article.handle == 'are-traditional-indian-pickles-good-for-gut-health-the-hidden-probiotic-benefits-of-sun-cured-achaar' -%}
              {%- assign dp_article_display_title = 'Are Traditional Indian Pickles Worth It?' -%}
            {%- endif -%}
            <div class="cms-group-title ">
              <div class="article-title">
                <a
                  class="h2"
                  href="{{ article.url}}"
                  title="{{ dp_article_display_title }}"
                  class="post-title">
                  {{- dp_article_display_title -}}
                </a>
              </div>
            </div>
          </div>

          <!-- SOCIAL SHARE BAR -->
          <div class="dp-share-bar">
            <span class="dp-share-label">Share Article:</span>
            <a href="https://api.whatsapp.com/send?text={{ article.title | url_encode }}%20{{ shop.url }}{{ article.url }}" target="_blank" class="dp-share-btn dp-share-btn--wa" title="Share on WhatsApp" aria-label="Share on WhatsApp">
              <svg width="17" height="17" viewBox="0 0 24 24" fill="currentColor"><path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.501-.669-.51l-.57-.01c-.198 0-.52.074-.792.372s-1.04 1.016-1.04 2.479 1.065 2.876 1.213 3.074c.149.198 2.095 3.2 5.076 4.487.709.306 1.263.489 1.694.626.712.226 1.36.194 1.872.118.571-.085 1.758-.719 2.006-1.413.248-.695.248-1.29.173-1.414-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413"/></svg>
              <span>WhatsApp</span>
            </a>
            <a href="https://www.facebook.com/sharer/sharer.php?u={{ shop.url }}{{ article.url }}" target="_blank" class="dp-share-btn dp-share-btn--fb" title="Share on Facebook" aria-label="Share on Facebook">
              <svg width="17" height="17" viewBox="0 0 24 24" fill="currentColor"><path d="M24 12.073c0-6.627-5.373-12-12-12s-12 5.373-12 12c0 5.99 4.388 10.954 10.125 11.854v-8.385H7.078v-3.47h3.047V9.43c0-3.007 1.792-4.669 4.533-4.669 1.312 0 2.686.235 2.686.235v2.953H15.83c-1.491 0-1.956.925-1.956 1.874v2.25h3.328l-.532 3.47h-2.796v8.385C19.612 23.027 24 18.062 24 12.073z"/></svg>
              <span>Facebook</span>
            </a>
            <a href="https://twitter.com/intent/tweet?text={{ article.title | url_encode }}&url={{ shop.url }}{{ article.url }}" target="_blank" class="dp-share-btn dp-share-btn--x" title="Share on X" aria-label="Share on X">
              <svg width="15" height="15" viewBox="0 0 24 24" fill="currentColor"><path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z"/></svg>
              <span>X</span>
            </a>
            <a href="https://www.linkedin.com/sharing/share-offsite/?url={{ shop.url }}{{ article.url }}" target="_blank" class="dp-share-btn dp-share-btn--in" title="Share on LinkedIn" aria-label="Share on LinkedIn">
              <svg width="15" height="15" viewBox="0 0 24 24" fill="currentColor"><path d="M19 3a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h14m-.5 15.5v-5.3a3.26 3.26 0 0 0-3.26-3.26c-.85 0-1.84.52-2.28 1.3v-1.11h-2.79v8.37h2.79v-4.93c0-.77.62-1.4 1.39-1.4a1.4 1.4 0 0 1 1.4 1.4v4.93h2.75M6.88 8.56a1.68 1.68 0 0 0 1.68-1.68c0-.93-.75-1.69-1.68-1.69a1.69 1.69 0 0 0-1.69 1.69c0 .93.76 1.68 1.69 1.68m1.39 9.94v-8.37H5.5v8.37h2.77z"/></svg>
              <span>LinkedIn</span>
            </a>
            {% assign pin_img = article.image | image_url: width: 1000 %}
            <a href="https://pinterest.com/pin/create/button/?url={{ shop.url }}{{ article.url }}&media={{ pin_img }}&description={{ article.title | url_encode }}" target="_blank" class="dp-share-btn dp-share-btn--pin" title="Pin on Pinterest" aria-label="Pin on Pinterest">
              <svg width="15" height="15" viewBox="0 0 24 24" fill="currentColor"><path d="M12.017 0C5.396 0 .029 5.367.029 11.987c0 5.079 3.158 9.417 7.618 11.162-.105-.949-.199-2.403.041-3.439.219-.937 1.406-5.957 1.406-5.957s-.359-.72-.359-1.781c0-1.663.967-2.911 2.168-2.911 1.024 0 1.518.769 1.518 1.688 0 1.029-.653 2.567-.992 3.992-.285 1.193.6 2.165 1.775 2.165 2.128 0 3.768-2.245 3.768-5.487 0-2.861-2.063-4.869-5.008-4.869-3.41 0-5.409 2.562-5.409 5.199 0 1.033.394 2.143.889 2.741.099.12.112.225.085.345-.09.375-.293 1.199-.334 1.363-.053.225-.172.271-.401.165-1.495-.69-2.433-2.878-2.433-4.646 0-3.776 2.748-7.252 7.92-7.252 4.158 0 7.392 2.967 7.392 6.923 0 4.135-2.607 7.462-6.233 7.462-1.214 0-2.354-.629-2.758-1.379l-.749 2.848c-.269 1.045-1.004 2.352-1.498 3.146 1.123.345 2.306.535 3.55.535 6.607 0 11.985-5.365 11.985-11.987C23.97 5.39 18.592.026 11.985.026l.032-.026z"/></svg>
              <span>Pinterest</span>
            </a>
            <button onclick="dpCopyArticleUrl(this)" class="dp-share-btn dp-share-btn--copy" title="Copy Article Link" aria-label="Copy Article Link">
              <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M10 13a5 5 0 0 0 7.54.54l3-3a5 5 0 0 0-7.07-7.07l-1.72 1.71"></path><path d="M14 11a5 5 0 0 0-7.54-.54l-3 3a5 5 0 0 0 7.07 7.07l1.71-1.71"></path></svg>
              <span>Copy Link</span>
            </button>
          </div>

          <script>
            function dpCopyArticleUrl(btn) {
              navigator.clipboard.writeText(window.location.href).then(function() {
                var origHTML = btn.innerHTML;
                btn.innerHTML = '<svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.8"><polyline points="20 6 9 17 4 12"></polyline></svg><span>Copied!</span>';
                btn.style.background = '#2e7d32';
                btn.style.borderColor = '#2e7d32';
                btn.style.color = '#ffffff';
                setTimeout(function() {
                  btn.innerHTML = origHTML;
                  btn.style.background = '';
                  btn.style.borderColor = '';
                  btn.style.color = '';
                }, 2200);
              });
            }
          </script>

          <!-- LISTEN TO ARTICLE AUDIO PLAYER WIDGET -->
          <div class="dp-audio-player-wrap" id="dpAudioPlayerWidget">
            <div class="dp-audio-player">
              <div class="dp-audio-top-row">
                <button class="dp-audio-play-btn" id="dpAudioPlayBtn" aria-label="Listen to Article">
                  <svg class="dp-icon-play" width="18" height="18" viewBox="0 0 24 24" fill="currentColor"><path d="M8 5v14l11-7z"/></svg>
                  <svg class="dp-icon-pause" width="18" height="18" viewBox="0 0 24 24" fill="currentColor" style="display:none;"><path d="M6 19h4V5H6v14zm8-14v14h4V5h-4z"/></svg>
                </button>
                <div class="dp-audio-info">
                  <div class="dp-audio-header">
                    <span class="dp-audio-title">🎧 Listen to Article</span>
                    <span class="dp-audio-time" id="dpAudioTime">0:00 / 0:00</span>
                  </div>
                  <div class="dp-audio-progress-bar" id="dpAudioProgressTrack">
                    <div class="dp-audio-progress-fill" id="dpAudioProgressFill"></div>
                  </div>
                </div>
              </div>
              <div class="dp-audio-controls">
                <select id="dpAudioVoiceSelect" class="dp-audio-voice-select" aria-label="Select Voice">
                  <option value="0">👩 Loading Voices...</option>
                </select>
                <select id="dpAudioSpeedSelect" class="dp-audio-speed" aria-label="Playback Speed">
                  <option value="1">1x</option>
                  <option value="1.25">1.25x</option>
                  <option value="1.5">1.5x</option>
                  <option value="2">2x</option>
                </select>
              </div>
            </div>
          </div>

          <script>
            (function() {
              var playBtn = document.getElementById('dpAudioPlayBtn');
              if (!playBtn) return;

              var playIcon = playBtn.querySelector('.dp-icon-play');
              var pauseIcon = playBtn.querySelector('.dp-icon-pause');
              var timeDisplay = document.getElementById('dpAudioTime');
              var progressFill = document.getElementById('dpAudioProgressFill');
              var progressTrack = document.getElementById('dpAudioProgressTrack');
              var speedSelect = document.getElementById('dpAudioSpeedSelect');
              var voiceSelect = document.getElementById('dpAudioVoiceSelect');

              var synth = window.speechSynthesis;
              var utterance = null;
              var isPlaying = false;
              var isPaused = false;
              var articleText = "";
              var textWords = [];
              var totalEstSeconds = 0;
              var timerInterval = null;
              var elapsedSeconds = 0;
              var availableFemaleVoices = [];

              function populateVoices() {
                if (!synth || !voiceSelect) return;
                var voices = synth.getVoices();
                if (!voices || !voices.length) return;

                var excludeNames = ['bad news', 'bahh', 'bells', 'boing', 'bubbles', 'cellos', 'organ', 'superstar', 'trinoids', 'wobble', 'zarvox', 'whisper', 'pipe', 'sin-ji', 'albert', 'alva', 'amél', 'amira', 'bad news', 'carmit', 'damayanti', 'daria', 'eddy', 'ellen', 'flo'];
                
                var validVoices = voices.filter(function(v) {
                  var nameLower = (v.name || '').toLowerCase();
                  return !excludeNames.some(function(ex) { return nameLower.includes(ex); });
                });

                var indianKeywords = ['india', 'indian', 'veena', 'neerja', 'heera', 'raveena', 'priya', 'lekha', 'komal', 'rishi', 'prabhat', 'ravi', 'aditi', 'shruti', 'meera', 'kanya', 'geeta', 'ananya', 'aarav'];
                var indianLangs = ['en-in', 'hi-in', 'gu-in', 'mr-in', 'ta-in', 'te-in', 'kn-in', 'ml-in', 'bn-in', 'pa-in'];

                function isIndian(v) {
                  var langLower = (v.lang || '').toLowerCase();
                  var nameLower = (v.name || '').toLowerCase();
                  var langMatch = indianLangs.some(function(l) { return langLower.includes(l); });
                  var nameMatch = indianKeywords.some(function(k) { return nameLower.includes(k); });
                  return langMatch || nameMatch;
                }

                var filteredVoices = validVoices.filter(isIndian);

                if (!filteredVoices.length) {
                  filteredVoices = validVoices.filter(function(v) {
                    return (v.lang || '').toLowerCase().startsWith('en');
                  }).slice(0, 2);
                }

                if (!filteredVoices.length) {
                  filteredVoices = validVoices.slice(0, 2);
                }

                availableFemaleVoices = filteredVoices;
                voiceSelect.innerHTML = '';

                filteredVoices.forEach(function(voice, index) {
                  var option = document.createElement('option');
                  option.value = index;
                  var rawName = voice.name || 'Voice ' + (index + 1);
                  var cleanName = rawName.replace(/Microsoft |Google |Apple /gi, '').replace(/\(Natural\)/gi, '').replace(/\(Online\)/gi, '').trim();
                  
                  var langLower = (voice.lang || '').toLowerCase();
                  var nameLower = rawName.toLowerCase();

                  if (nameLower.includes('lekha')) {
                    option.textContent = "👩 Lekha (Indian Voice)";
                  } else if (nameLower.includes('veena')) {
                    option.textContent = "👩 Veena (Indian English)";
                  } else if (nameLower.includes('neerja')) {
                    option.textContent = "👩 Neerja (Indian Voice)";
                  } else if (nameLower.includes('heera')) {
                    option.textContent = "👩 Heera (Indian Voice)";
                  } else if (nameLower.includes('rishi')) {
                    option.textContent = "👨 Rishi (Indian Voice)";
                  } else if (nameLower.includes('raveena') || nameLower.includes('priya')) {
                    option.textContent = "👩 " + cleanName + " (Indian Voice)";
                  } else if (langLower.includes('hi-in')) {
                    option.textContent = "👩 Hindi Voice (India)";
                  } else if (langLower.includes('gu-in')) {
                    option.textContent = "👩 Gujarati Voice (India)";
                  } else if (langLower.includes('en-in')) {
                    option.textContent = "👩 " + cleanName + " (Indian English)";
                  } else {
                    option.textContent = "👩 " + cleanName + " (Indian Voice)";
                  }

                  voiceSelect.appendChild(option);
                });
              }

              if (synth.onvoiceschanged !== undefined) {
                synth.onvoiceschanged = populateVoices;
              }
              setTimeout(populateVoices, 300);

              function extractArticleText() {
                var articleEl = document.querySelector('.main-info-post') || document.querySelector('.post-info');
                if (!articleEl) return "";
                var clone = articleEl.cloneNode(true);
                var removeEls = clone.querySelectorAll('script, style, button, .dp-cta-box, form');
                removeEls.forEach(function(el) { el.remove(); });
                var text = clone.innerText || clone.textContent || "";
                return text.replace(/\s+/g, ' ').trim();
              }

              function formatTime(sec) {
                var m = Math.floor(sec / 60);
                var s = Math.floor(sec % 60);
                return m + ":" + (s < 10 ? "0" : "") + s;
              }

              function updateTimeDisplay() {
                var currentSpd = parseFloat(speedSelect.value) || 1;
                var adjTotal = Math.ceil(totalEstSeconds / currentSpd);
                if (elapsedSeconds > adjTotal) elapsedSeconds = adjTotal;
                timeDisplay.textContent = formatTime(elapsedSeconds) + " / " + formatTime(adjTotal);
                var pct = adjTotal > 0 ? (elapsedSeconds / adjTotal) * 100 : 0;
                progressFill.style.width = Math.min(100, pct) + "%";
              }

              function initAudioData() {
                articleText = extractArticleText();
                textWords = articleText.split(' ');
                totalEstSeconds = Math.ceil((textWords.length / 150) * 60) || 60;
                updateTimeDisplay();
                populateVoices();
              }

              function startTimer() {
                clearInterval(timerInterval);
                timerInterval = setInterval(function() {
                  if (isPlaying && !isPaused) {
                    elapsedSeconds++;
                    updateTimeDisplay();
                  }
                }, 1000);
              }

              function stopTimer() {
                clearInterval(timerInterval);
              }

              function toggleAudio() {
                if (!synth) {
                  alert("Text-to-speech audio is not supported in your browser.");
                  return;
                }

                if (isPlaying && !isPaused) {
                  synth.pause();
                  isPaused = true;
                  playIcon.style.display = "block";
                  pauseIcon.style.display = "none";
                  stopTimer();
                  return;
                }

                if (isPlaying && isPaused) {
                  synth.resume();
                  isPaused = false;
                  playIcon.style.display = "none";
                  pauseIcon.style.display = "block";
                  startTimer();
                  return;
                }

                if (!articleText) initAudioData();
                if (!articleText) return;

                synth.cancel();
                utterance = new SpeechSynthesisUtterance(articleText);
                utterance.rate = (parseFloat(speedSelect.value) || 1) * 0.95;
                utterance.pitch = 1.3;

                var selectedIdx = parseInt(voiceSelect.value) || 0;
                if (availableFemaleVoices[selectedIdx]) {
                  utterance.voice = availableFemaleVoices[selectedIdx];
                  utterance.lang = availableFemaleVoices[selectedIdx].lang || 'en-IN';
                } else {
                  utterance.lang = 'en-IN';
                }

                utterance.onstart = function() {
                  isPlaying = true;
                  isPaused = false;
                  playIcon.style.display = "none";
                  pauseIcon.style.display = "block";
                  startTimer();
                };

                utterance.onend = function() {
                  isPlaying = false;
                  isPaused = false;
                  elapsedSeconds = 0;
                  playIcon.style.display = "block";
                  pauseIcon.style.display = "none";
                  progressFill.style.width = "0%";
                  stopTimer();
                  updateTimeDisplay();
                };

                utterance.onerror = function() {
                  isPlaying = false;
                  isPaused = false;
                  playIcon.style.display = "block";
                  pauseIcon.style.display = "none";
                  stopTimer();
                };

                synth.speak(utterance);
              }

              playBtn.addEventListener('click', toggleAudio);

              voiceSelect.addEventListener('change', function() {
                if (isPlaying && utterance) {
                  synth.cancel();
                  isPlaying = false;
                  isPaused = false;
                  stopTimer();
                  toggleAudio();
                }
              });

              speedSelect.addEventListener('change', function() {
                if (isPlaying && utterance) {
                  synth.cancel();
                  isPlaying = false;
                  isPaused = false;
                  stopTimer();
                  toggleAudio();
                } else {
                  updateTimeDisplay();
                }
              });

              progressTrack.addEventListener('click', function(e) {
                if (!totalEstSeconds) return;
                var rect = progressTrack.getBoundingClientRect();
                var clickX = e.clientX - rect.left;
                var pct = clickX / rect.width;
                var currentSpd = parseFloat(speedSelect.value) || 1;
                var adjTotal = Math.ceil(totalEstSeconds / currentSpd);
                elapsedSeconds = Math.floor(pct * adjTotal);
                updateTimeDisplay();
              });

              if (document.readyState === 'loading') {
                document.addEventListener('DOMContentLoaded', initAudioData);
              } else {
                initAudioData();
              }
            })();
          </script>
          <div class="post-item">
            <div class="post-info">
              <div class="main-info-post">
                {% if article.excerpt.size > 0 %}
                  {% comment %}{{ article.excerpt | strip_html}} {% endcomment %}
                  <div class="des">{{ article.content }}</div>
                {% else %}
                  <div>{{ article.content }}</div>
                {% endif %}
              </div>
            </div>
          </div>
          <div class="content-blog-bottom">
            {% if show_tags %}
              <div class="tags d-flex align-items-center gap-2">
                <h6>Tags:</h6>
                {% if article.tags.size > 0 %}
                  {% include 'tags-article'
                    , limit: limit_tags %}
                {% endif %}
              </div>
            {% endif %}
            {% if show_social %}
              <div class="d-flex align-items-center gap-2">
                <svg
                  xmlns="http://www.w3.org/2000/svg"
                  width="20"
                  height="20"
                  viewBox="0 0 20 20"
                  fill="none">
                  <path d="M15.4228 13.4529C14.4645 13.4529 13.6012 13.8667 13.002 14.525L7.61244 11.187C7.75633 10.8186 7.83614 10.4185 7.83614 9.99998C7.83614 9.58128 7.75633 9.1812 7.61244 8.813L13.002 5.47484C13.6012 6.13311 14.4645 6.54708 15.4228 6.54708C17.2279 6.54708 18.6964 5.07857 18.6964 3.27346C18.6964 1.46835 17.2279 0 15.4228 0C13.6177 0 12.1492 1.4685 12.1492 3.27361C12.1492 3.69216 12.2291 4.09225 12.3729 4.46059L6.98348 7.7986C6.38427 7.14034 5.52093 6.72637 4.56268 6.72637C2.75757 6.72637 1.28906 8.19502 1.28906 9.99998C1.28906 11.8051 2.75757 13.2736 4.56268 13.2736C5.52093 13.2736 6.38427 12.8598 6.98348 12.2014L12.3729 15.5394C12.2291 15.9077 12.1492 16.3078 12.1492 16.7265C12.1492 18.5315 13.6177 20 15.4228 20C17.2279 20 18.6964 18.5315 18.6964 16.7265C18.6964 14.9214 17.2279 13.4529 15.4228 13.4529ZM13.3429 3.27361C13.3429 2.12677 14.2759 1.19369 15.4228 1.19369C16.5696 1.19369 17.5027 2.12677 17.5027 3.27361C17.5027 4.42046 16.5696 5.35354 15.4228 5.35354C14.2759 5.35354 13.3429 4.42046 13.3429 3.27361ZM4.56268 12.0799C3.41568 12.0799 2.4826 11.1468 2.4826 9.99998C2.4826 8.85313 3.41568 7.92006 4.56268 7.92006C5.70952 7.92006 6.64244 8.85313 6.64244 9.99998C6.64244 11.1468 5.70952 12.0799 4.56268 12.0799ZM13.3429 16.7263C13.3429 15.5795 14.2759 14.6464 15.4228 14.6464C16.5696 14.6464 17.5027 15.5795 17.5027 16.7263C17.5027 17.8732 16.5696 18.8063 15.4228 18.8063C14.2759 18.8063 13.3429 17.8732 13.3429 16.7263Z" fill="#141516" />
                </svg>
                <h6>
                  Share:</h6>
                {% include 'social-sharing' %}
              </div>
            {% endif %}
          </div>
          <div class="paginate-post">
            {% if blog.next_article or blog.previous_article %}
              {% if blog.previous_article %}
                <div class="left">
                  <span class="icon-chevron-left"></span>
                  {{- 'blogs.article.older_post' | t | link_to: blog.previous_article }}
                </div>
              {% endif %}
              {% if blog.next_article %}
                <div class="right">
                  {{ 'blogs.article.newer_post' | t | link_to: blog.next_article }}
                  <span class="icon-chevron-right"></span>
                </div>
              {% endif %}
            {% endif %}
          </div>
          {% if section.settings.comment_use_chk %}
            <div id="primary" class="list-comment content-form">
              {% if article.comments_count > 0 %}
                <h4 class="main-title">
                  {% if article.comments_count > 1 -%}
                    {{- 'blogs.comments.comments_with_count.other' | t: count: article.comments_count }}
                  {% else %}
                    {{ 'blogs.comments.comments_with_count.one' | t: count: article.comments_count }}
                  {% endif %}
                </h4>

              {% endif %}
              {% paginate article.comments by 3 %}
                {% if blog.comments_enabled? %}
                  {% if comment and comment.created_at %}
                    <p class="note form-success">
                      {% if blog.moderated? %}
                        {{ 'blogs.comments.success_moderated' | t }}
                      {% else %}
                        {{ 'blogs.comments.success' | t }}
                      {% endif %}
                    </p>
                  {% endif %}
                  {% if article.comments_count > 0 %}
                    {% for comment in article.comments %}
                      {% include 'comment' %}
                    {% endfor %}
                  {% endif %}

                  {% if paginate.pages > 1 %}
                    {% include 'pagination' %}
                  {% endif %}
                {% endif %}
              {% endpaginate %}
              {% include 'blog-comment-form' %}
            </div>
          {% endif %}
        </div>
      </div>

      {% if layout != 1 %}
        {% if chk_sidebar %}
          {% include 'blog-sidebar'
            , layout: layout %}
        {% endif %}
      {% endif %}
    </div>
  </div>
</div>
{%- render 'section_style' -%}
{% style %}
  body {
    --color-bg-body: {{ section.settings.cl_bg }};
  }

  /* SHARE BAR & AUDIO PLAYER FOR MAIN ARTICLE SECTION */
  .dp-share-bar {
    display: flex;
    align-items: center;
    gap: 8px;
    padding: 12px 18px;
    background: #ffffff;
    border: 1px solid #e8d5c0;
    border-radius: 50px;
    margin-bottom: 20px;
    font-size: 13px;
    font-weight: 700;
    color: #3d1f0f;
    flex-wrap: wrap;
    box-shadow: 0 4px 14px rgba(61,31,15,0.04);
  }
  .dp-share-label {
    font-size: 12px;
    font-weight: 800;
    color: #3d1f0f;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    margin-right: 4px;
  }
  .dp-share-btn {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    padding: 7px 13px;
    border-radius: 50px;
    font-size: 12px;
    font-weight: 700;
    text-decoration: none !important;
    transition: all 0.22s ease;
    border: 1px solid transparent;
    cursor: pointer;
    line-height: 1;
  }
  .dp-share-btn svg { display: block; flex-shrink: 0; }
  .dp-share-btn:hover { transform: translateY(-2px); box-shadow: 0 4px 10px rgba(0,0,0,0.14); }
  .dp-share-btn--wa { background: #25D366; color: #ffffff !important; }
  .dp-share-btn--wa:hover { background: #20bd5a; }
  .dp-share-btn--fb { background: #1877F2; color: #ffffff !important; }
  .dp-share-btn--fb:hover { background: #1365d0; }
  .dp-share-btn--x { background: #0f1419; color: #ffffff !important; }
  .dp-share-btn--x:hover { background: #000000; }
  .dp-share-btn--in { background: #0A66C2; color: #ffffff !important; }
  .dp-share-btn--in:hover { background: #08529c; }
  .dp-share-btn--pin { background: #E60023; color: #ffffff !important; }
  .dp-share-btn--pin:hover { background: #bd001c; }
  .dp-share-btn--copy { background: #f4ece1; color: #3d1f0f !important; border-color: #e8d5c0; }
  .dp-share-btn--copy:hover { background: #e8dbcb; }

  @media screen and (max-width: 767px) {
    .dp-share-bar { padding: 8px 12px !important; gap: 6px !important; border-radius: 30px !important; align-items: center !important; justify-content: space-between !important; }
    .dp-share-label { font-size: 11px !important; letter-spacing: 0 !important; margin-right: 2px !important; }
    .dp-share-btn { width: 35px !important; height: 35px !important; padding: 0 !important; border-radius: 50% !important; justify-content: center !important; align-items: center !important; flex-shrink: 0 !important; }
    .dp-share-btn span { display: none !important; }
    .dp-share-btn svg { margin: 0 !important; width: 17px !important; height: 17px !important; }

    .dp-audio-player-wrap { padding: 0 !important; margin-bottom: 24px !important; width: 100% !important; box-sizing: border-box !important; }
    .dp-audio-player { display: flex !important; flex-direction: column !important; padding: 14px 16px !important; border-radius: 16px !important; gap: 12px !important; width: 100% !important; max-width: 100% !important; box-sizing: border-box !important; overflow: hidden !important; }
    .dp-audio-top-row { display: flex !important; align-items: center !important; gap: 12px !important; width: 100% !important; box-sizing: border-box !important; flex: 0 0 auto !important; }
    .dp-audio-play-btn { width: 44px !important; height: 44px !important; min-width: 44px !important; max-width: 44px !important; flex: 0 0 44px !important; box-sizing: border-box !important; }
    .dp-audio-info { flex: 1 1 auto !important; min-width: 0 !important; width: calc(100% - 56px) !important; box-sizing: border-box !important; }
    .dp-audio-header { display: flex !important; align-items: center !important; justify-content: space-between !important; gap: 6px !important; width: 100% !important; }
    .dp-audio-title { font-size: 13px !important; line-height: 1.2 !important; white-space: nowrap !important; overflow: hidden !important; text-overflow: ellipsis !important; flex: 1 1 auto !important; min-width: 0 !important; }
    .dp-audio-time { font-size: 11.5px !important; white-space: nowrap !important; flex-shrink: 0 !important; }
    .dp-audio-progress-bar { width: 100% !important; height: 6px !important; margin-top: 4px !important; }
    .dp-audio-controls { width: 100% !important; flex: 0 0 auto !important; display: flex !important; justify-content: space-between !important; align-items: center !important; margin-top: 0 !important; gap: 8px !important; box-sizing: border-box !important; }
    .dp-audio-voice-select { max-width: calc(100% - 62px) !important; flex: 1 1 auto !important; min-width: 0 !important; height: 34px !important; font-size: 11.5px !important; padding: 0 8px !important; text-overflow: ellipsis !important; white-space: nowrap !important; overflow: hidden !important; border-radius: 10px !important; box-sizing: border-box !important; }
    .dp-audio-speed { flex: 0 0 54px !important; width: 54px !important; height: 34px !important; font-size: 11.5px !important; padding: 0 6px !important; border-radius: 10px !important; text-align: center !important; box-sizing: border-box !important; }

    .dp-translate-widget { display: flex !important; flex-wrap: wrap !important; align-items: center !important; gap: 6px !important; margin-top: 8px !important; margin-left: 0 !important; width: 100% !important; max-width: 100% !important; box-sizing: border-box !important; padding: 6px 12px !important; border-radius: 20px !important; }
    .dp-translate-title { font-size: 11px !important; }
    #google_translate_element { display: inline-block !important; max-width: 100% !important; }
    .goog-te-gadget-simple { max-width: 100% !important; box-sizing: border-box !important; }
  }

  .dp-audio-player-wrap { margin-bottom: 28px; }
  .dp-audio-player { display: flex; align-items: center; justify-content: space-between; gap: 16px; padding: 16px 20px; background: linear-gradient(135deg, #fffcf7 0%, #fdf5ea 100%); border: 1.5px solid #e8d5c0; border-radius: 20px; box-shadow: 0 4px 16px rgba(61,31,15,0.05); }
