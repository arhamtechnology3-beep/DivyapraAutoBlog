  .sidebar .dp-product-mini-card__info h4 a:hover, .dp-sticky-sidebar-wrapper .dp-product-mini-card__info h4 a:hover { color: #b01215 !important; }
  .sidebar .dp-product-price, .dp-sticky-sidebar-wrapper .dp-product-price { display: flex !important; align-items: center !important; gap: 6px !important; margin: 0 !important; }
  .sidebar .dp-price-current, .dp-sticky-sidebar-wrapper .dp-price-current { font-size: 13.5px !important; font-weight: 900 !important; color: #b01215 !important; }
