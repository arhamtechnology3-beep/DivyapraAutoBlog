  .sidebar .dp-cat-count, .dp-sticky-sidebar-wrapper .dp-cat-count { color: #8c6d58 !important; font-size: 11px !important; font-weight: 700 !important; }

  .sidebar .dp-recent-topics-list, .dp-sticky-sidebar-wrapper .dp-recent-topics-list { list-style: none !important; padding: 0 !important; margin: 0 !important; display: flex !important; flex-direction: column !important; gap: 10px !important; }
  .sidebar .dp-recent-topics-list li, .dp-sticky-sidebar-wrapper .dp-recent-topics-list li { padding: 10px 12px !important; margin: 0 !important; background: #ffffff !important; border: 1px solid #e8d5c0 !important; border-radius: 12px !important; display: flex !important; flex-direction: column !important; gap: 4px !important; transition: all 0.2s ease !important; }
  .sidebar .dp-recent-topics-list li:hover, .dp-sticky-sidebar-wrapper .dp-recent-topics-list li:hover { border-color: #b01215 !important; box-shadow: 0 4px 12px rgba(61, 31, 15, 0.05) !important; }
  .sidebar .dp-topic-tag, .dp-sticky-sidebar-wrapper .dp-topic-tag { display: inline-block !important; font-size: 9px !important; font-weight: 800 !important; color: #b01215 !important; text-transform: uppercase !important; letter-spacing: 0.04em !important; background: #fdf6ed !important; padding: 2px 6px !important; border-radius: 4px !important; width: fit-content !important; }
  .sidebar .dp-recent-topics-list a, .dp-sticky-sidebar-wrapper .dp-recent-topics-list a { font-size: 12.5px !important; font-weight: 700 !important; color: #3d1f0f !important; line-height: 1.35 !important; text-decoration: none !important; }
  .sidebar .dp-recent-topics-list a:hover, .dp-sticky-sidebar-wrapper .dp-recent-topics-list a:hover { color: #b01215 !important; }

  .sidebar .dp-keywords-cloud, .dp-sticky-sidebar-wrapper .dp-keywords-cloud { display: flex !important; flex-wrap: wrap !important; gap: 8px !important; padding: 4px 0 !important; }
  .sidebar .dp-tag-pill, .dp-sticky-sidebar-wrapper .dp-tag-pill { background: #ffffff !important; border: 1.5px solid #e8d5c0 !important; color: #3d1f0f !important; padding: 6px 12px !important; border-radius: 50px !important; font-size: 11.5px !important; font-weight: 700 !important; text-decoration: none !important; display: inline-block !important; transition: all 0.2s ease !important; box-shadow: 0 2px 6px rgba(61, 31, 15, 0.03) !important; }
  .sidebar .dp-tag-pill:hover, .sidebar .dp-tag-pill.active, .dp-sticky-sidebar-wrapper .dp-tag-pill:hover, .dp-sticky-sidebar-wrapper .dp-tag-pill.active { background: #b01215 !important; color: #ffffff !important; border-color: #b01215 !important; transform: translateY(-1px) !important; box-shadow: 0 4px 10px rgba(176, 18, 21, 0.25) !important; }
{% endstyle %}
{% schema %}
  {
    "name": "Article",
    "settings": [
      {
        "type": "header",
        "content": "==General setting"
      },
      {
        "type": "select",
        "id": "layout_blog",
        "label": "Select layout",
        "options": [
          {
            "value": "1",
            "label": "Grid layout without sidebar"
          }, {
            "value": "2",
            "label": "Grid layout within left sidebar"
          }, {
            "value": "3",
            "label": "Grid layout within right sidebar"
          }
        ],
        "default": "2"
      },
      {
        "type": "checkbox",
        "id": "comment_use_chk",
        "label": "Show comment on blog post",
        "default": true
      },
      {
        "type": "checkbox",
        "id": "show_tags",
        "label": "Show tags on blog post",
        "default": true
      }, {
        "type": "range",
