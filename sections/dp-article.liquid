            <span>Pinterest</span>
          </a>

          <!-- Copy Link -->
          <button onclick="dpCopyArticleUrl(this)" class="dp-share-btn dp-share-btn--copy" title="Copy Article Link" aria-label="Copy Article Link">
            <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M10 13a5 5 0 0 0 7.54.54l3-3a5 5 0 0 0-7.07-7.07l-1.72 1.71"></path><path d="M14 11a5 5 0 0 0-7.54-.54l-3 3a5 5 0 0 0 7.07 7.07l1.71-1.71"></path></svg>
            <span>Copy Link</span>
          </button>
        </div>

        <script>
          function dpCopyArticleUrl(btn) {
            navigator.clipboard.writeText(window.location.href).then(function() {
              var origHTML = btn.innerHTML;
              btn.innerHTML = '<svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.8"><polyline points="20 6 9 17 4 12"></polyline></svg><span>Copied!</span>';
              btn.style.background = '#2e7d32';
              btn.style.borderColor = '#2e7d32';
              btn.style.color = '#ffffff';
              setTimeout(function() {
                btn.innerHTML = origHTML;
                btn.style.background = '';
                btn.style.borderColor = '';
                btn.style.color = '';
              }, 2200);
            });
          }
        </script>

        <!-- LISTEN TO ARTICLE AUDIO PLAYER WIDGET -->
        <div class="dp-audio-player-wrap" id="dpAudioPlayerWidget">
          <div class="dp-audio-player">
            <div class="dp-audio-top-row">
              <button class="dp-audio-play-btn" id="dpAudioPlayBtn" aria-label="Listen to Article">
                <svg class="dp-icon-play" width="18" height="18" viewBox="0 0 24 24" fill="currentColor"><path d="M8 5v14l11-7z"/></svg>
                <svg class="dp-icon-pause" width="18" height="18" viewBox="0 0 24 24" fill="currentColor" style="display:none;"><path d="M6 19h4V5H6v14zm8-14v14h4V5h-4z"/></svg>
              </button>
              <div class="dp-audio-info">
                <div class="dp-audio-header">
                  <span class="dp-audio-title">🎧 Listen to Article</span>
                  <span class="dp-audio-time" id="dpAudioTime">0:00 / 0:00</span>
                </div>
                <div class="dp-audio-progress-bar" id="dpAudioProgressTrack">
                  <div class="dp-audio-progress-fill" id="dpAudioProgressFill"></div>
                </div>
              </div>
            </div>
            <div class="dp-audio-controls">
              <select id="dpAudioVoiceSelect" class="dp-audio-voice-select" aria-label="Select Voice">
                <option value="0">👩 Loading Voices...</option>
              </select>
              <select id="dpAudioSpeedSelect" class="dp-audio-speed" aria-label="Playback Speed">
                <option value="1">1x</option>
                <option value="1.25">1.25x</option>
                <option value="1.5">1.5x</option>
                <option value="2">2x</option>
              </select>
            </div>
          </div>
        </div>

        <script>
          (function() {
            var playBtn = document.getElementById('dpAudioPlayBtn');
            if (!playBtn) return;

            var playIcon = playBtn.querySelector('.dp-icon-play');
            var pauseIcon = playBtn.querySelector('.dp-icon-pause');
            var timeDisplay = document.getElementById('dpAudioTime');
            var progressFill = document.getElementById('dpAudioProgressFill');
            var progressTrack = document.getElementById('dpAudioProgressTrack');
            var speedSelect = document.getElementById('dpAudioSpeedSelect');
            var voiceSelect = document.getElementById('dpAudioVoiceSelect');

            var synth = window.speechSynthesis;
            var utterance = null;
            var isPlaying = false;
            var isPaused = false;
            var articleText = "";
            var textWords = [];
            var totalEstSeconds = 0;
            var timerInterval = null;
            var elapsedSeconds = 0;
            var availableFemaleVoices = [];

              function populateVoices() {
                if (!synth || !voiceSelect) return;
                var voices = synth.getVoices();
                if (!voices || !voices.length) return;

                var excludeNames = ['bad news', 'bahh', 'bells', 'boing', 'bubbles', 'cellos', 'organ', 'superstar', 'trinoids', 'wobble', 'zarvox', 'whisper', 'pipe', 'sin-ji', 'albert', 'alva', 'amél', 'amira', 'bad news', 'carmit', 'damayanti', 'daria', 'eddy', 'ellen', 'flo'];
                
                var validVoices = voices.filter(function(v) {
                  var nameLower = (v.name || '').toLowerCase();
                  return !excludeNames.some(function(ex) { return nameLower.includes(ex); });
                });

                var indianKeywords = ['india', 'indian', 'veena', 'neerja', 'heera', 'raveena', 'priya', 'lekha', 'komal', 'rishi', 'prabhat', 'ravi', 'aditi', 'shruti', 'meera', 'kanya', 'geeta', 'ananya', 'aarav'];
                var indianLangs = ['en-in', 'hi-in', 'gu-in', 'mr-in', 'ta-in', 'te-in', 'kn-in', 'ml-in', 'bn-in', 'pa-in'];

                function isIndian(v) {
                  var langLower = (v.lang || '').toLowerCase();
                  var nameLower = (v.name || '').toLowerCase();
                  var langMatch = indianLangs.some(function(l) { return langLower.includes(l); });
                  var nameMatch = indianKeywords.some(function(k) { return nameLower.includes(k); });
                  return langMatch || nameMatch;
                }

                var filteredVoices = validVoices.filter(isIndian);

                if (!filteredVoices.length) {
                  filteredVoices = validVoices.filter(function(v) {
                    return (v.lang || '').toLowerCase().startsWith('en');
                  }).slice(0, 2);
                }

                if (!filteredVoices.length) {
                  filteredVoices = validVoices.slice(0, 2);
                }

                availableFemaleVoices = filteredVoices;
                voiceSelect.innerHTML = '';

                filteredVoices.forEach(function(voice, index) {
                  var option = document.createElement('option');
                  option.value = index;
                  var rawName = voice.name || 'Voice ' + (index + 1);
                  var cleanName = rawName.replace(/Microsoft |Google |Apple /gi, '').replace(/\(Natural\)/gi, '').replace(/\(Online\)/gi, '').trim();
                  
                  var langLower = (voice.lang || '').toLowerCase();
                  var nameLower = rawName.toLowerCase();

                  if (nameLower.includes('lekha')) {
                    option.textContent = "👩 Lekha (Indian Voice)";
                  } else if (nameLower.includes('veena')) {
                    option.textContent = "👩 Veena (Indian English)";
                  } else if (nameLower.includes('neerja')) {
                    option.textContent = "👩 Neerja (Indian Voice)";
                  } else if (nameLower.includes('heera')) {
                    option.textContent = "👩 Heera (Indian Voice)";
                  } else if (nameLower.includes('rishi')) {
                    option.textContent = "👨 Rishi (Indian Voice)";
                  } else if (nameLower.includes('raveena') || nameLower.includes('priya')) {
                    option.textContent = "👩 " + cleanName + " (Indian Voice)";
                  } else if (langLower.includes('hi-in')) {
                    option.textContent = "👩 Hindi Voice (India)";
                  } else if (langLower.includes('gu-in')) {
                    option.textContent = "👩 Gujarati Voice (India)";
                  } else if (langLower.includes('en-in')) {
                    option.textContent = "👩 " + cleanName + " (Indian English)";
                  } else {
                    option.textContent = "👩 " + cleanName + " (Indian Voice)";
                  }

                  voiceSelect.appendChild(option);
                });
              }

            if (synth.onvoiceschanged !== undefined) {
              synth.onvoiceschanged = populateVoices;
            }
            setTimeout(populateVoices, 300);

            function extractArticleText() {
              var articleEl = document.querySelector('.dp-article-content');
              if (!articleEl) return "";
              var clone = articleEl.cloneNode(true);
              var removeEls = clone.querySelectorAll('script, style, button, .dp-cta-box, form');
              removeEls.forEach(function(el) { el.remove(); });
              var text = clone.innerText || clone.textContent || "";
              return text.replace(/\s+/g, ' ').trim();
            }

            function formatTime(sec) {
              var m = Math.floor(sec / 60);
              var s = Math.floor(sec % 60);
              return m + ":" + (s < 10 ? "0" : "") + s;
            }

            function updateTimeDisplay() {
              var currentSpd = parseFloat(speedSelect.value) || 1;
              var adjTotal = Math.ceil(totalEstSeconds / currentSpd);
              if (elapsedSeconds > adjTotal) elapsedSeconds = adjTotal;
              timeDisplay.textContent = formatTime(elapsedSeconds) + " / " + formatTime(adjTotal);
              var pct = adjTotal > 0 ? (elapsedSeconds / adjTotal) * 100 : 0;
              progressFill.style.width = Math.min(100, pct) + "%";
            }

            function initAudioData() {
              articleText = extractArticleText();
              textWords = articleText.split(' ');
              totalEstSeconds = Math.ceil((textWords.length / 150) * 60) || 60;
              updateTimeDisplay();
              populateVoices();
            }

            function startTimer() {
              clearInterval(timerInterval);
              timerInterval = setInterval(function() {
                if (isPlaying && !isPaused) {
                  elapsedSeconds++;
                  updateTimeDisplay();
                }
              }, 1000);
            }

            function stopTimer() {
              clearInterval(timerInterval);
            }

            function toggleAudio() {
              if (!synth) {
                alert("Text-to-speech audio is not supported in your browser.");
                return;
              }

              if (isPlaying && !isPaused) {
                synth.pause();
                isPaused = true;
                playIcon.style.display = "block";
                pauseIcon.style.display = "none";
                stopTimer();
                return;
              }

              if (isPlaying && isPaused) {
                synth.resume();
                isPaused = false;
                playIcon.style.display = "none";
                pauseIcon.style.display = "block";
                startTimer();
                return;
              }

              if (!articleText) initAudioData();
              if (!articleText) return;

              synth.cancel();
              utterance = new SpeechSynthesisUtterance(articleText);
              utterance.rate = (parseFloat(speedSelect.value) || 1) * 0.95;
              utterance.pitch = 1.3;

              var selectedIdx = parseInt(voiceSelect.value) || 0;
              if (availableFemaleVoices[selectedIdx]) {
                utterance.voice = availableFemaleVoices[selectedIdx];
                utterance.lang = availableFemaleVoices[selectedIdx].lang || 'en-IN';
              } else {
                utterance.lang = 'en-IN';
              }

              utterance.onstart = function() {
                isPlaying = true;
                isPaused = false;
                playIcon.style.display = "none";
                pauseIcon.style.display = "block";
                startTimer();
              };

              utterance.onend = function() {
                isPlaying = false;
                isPaused = false;
                elapsedSeconds = 0;
                playIcon.style.display = "block";
                pauseIcon.style.display = "none";
                progressFill.style.width = "0%";
                stopTimer();
                updateTimeDisplay();
              };

              utterance.onerror = function() {
                isPlaying = false;
                isPaused = false;
                playIcon.style.display = "block";
                pauseIcon.style.display = "none";
                stopTimer();
              };

              synth.speak(utterance);
            }

            playBtn.addEventListener('click', toggleAudio);

            voiceSelect.addEventListener('change', function() {
              if (isPlaying && utterance) {
                synth.cancel();
                isPlaying = false;
                isPaused = false;
                stopTimer();
                toggleAudio();
              }
            });

            speedSelect.addEventListener('change', function() {
              if (isPlaying && utterance) {
                synth.cancel();
                isPlaying = false;
                isPaused = false;
                stopTimer();
                toggleAudio();
              } else {
                updateTimeDisplay();
              }
            });

            progressTrack.addEventListener('click', function(e) {
              if (!totalEstSeconds) return;
              var rect = progressTrack.getBoundingClientRect();
              var clickX = e.clientX - rect.left;
              var pct = clickX / rect.width;
              var currentSpd = parseFloat(speedSelect.value) || 1;
              var adjTotal = Math.ceil(totalEstSeconds / currentSpd);
              elapsedSeconds = Math.floor(pct * adjTotal);
              updateTimeDisplay();
            });

            if (document.readyState === 'loading') {
              document.addEventListener('DOMContentLoaded', initAudioData);
            } else {
              initAudioData();
            }
          })();
        </script>

        <!-- ARTICLE BODY -->
        <article class="dp-article-content">
          {%- if article.handle == 'gorkeri-pickle-health' -%}
            <!-- GSC-FIRST-WAVE:GOR-KERI-ANSWER -->
            <p><strong>Gor Keri</strong> means sweet jaggery mango pickle — raw mango cured with gur (jaggery) in the Gujarati / Saurashtra style. At Divyaprabha Foods, Gor Keri is peanut-oil cured, made in small batches from Baa's recipe since 1980, with no vinegar and no sodium benzoate.</p>
            <p>If you searched <em>gorkeri means</em> or <em>gorkeri pickle meaning</em>, you are looking for that sweet–tangy jar, not a spicy mustard achar. Below is how we make it, and how it differs from Chhundo and Meethi Keri.</p>
            <div class="dp-product-card" style="background:#fdf6ed;border:1px solid #e8d5c0;border-radius:16px;padding:24px;margin:32px 0;text-align:center;box-shadow:0 4px 12px rgba(61,31,15,0.05);">
              <img src="https://cdn.shopify.com/s/files/1/0752/0904/8278/files/Gor_Keri_500g.webp?v=1784831601" alt="Gor Keri jaggery mango pickle jar - Divyaprabha Foods" style="max-width:240px;width:100%;height:auto;border-radius:12px;margin-bottom:16px;">
              <h3 style="color:#b01215;margin:8px 0 12px 0;font-size:20px;">Gor Keri | Jaggery Mango Achar</h3>
              <p style="color:#3d1f0f;font-size:14px;margin-bottom:16px;">Sweet jaggery mango achar, peanut-oil cured in Saurashtra. No vinegar, no preservatives.</p>
              <a href="/products/gor-keri-pickle-jaggery-mango-achar-gujarati" style="background:#b01215;color:#ffffff;padding:12px 32px;border-radius:50px;font-weight:bold;text-decoration:none;display:inline-block;">Buy Authentic Gor Keri Online →</a>
            </div>
            <!-- /GSC-FIRST-WAVE:GOR-KERI-ANSWER -->
          {%- endif -%}
          {%- if article.content != blank -%}
            {{ article.content }}
          {%- else -%}
            <!-- DEMO ARTICLE CONTENT -->
            <p class="dp-lead">
              In an Indian household, a meal is never truly complete without a jar of homemade pickle resting on the dining table. The sharp, irresistible aroma of cold-pressed mustard oil, sun-dried raw mangoes, and hand-ground spices instantly evokes memories of hot summers and grandmothers lovingly preparing jars that lasted an entire year.
            </p>

            <h2>1. Traditional Rajapuri Raw Mango Pickle (Aam Ka Achar)</h2>
            <p>Known as the King of Indian Pickles, authentic raw mango pickle holds a permanent throne in Indian homes. Made with firm Rajapuri raw mangoes, cold-pressed mustard oil, and split fenugreek seeds.</p>

            <h2>2. Saurashtra Stuffed Red Chilli Pickle (Bharwa Lal Mirch)</h2>
            <p>A winter delicacy prepared from vibrant red Banarasi chillies stuffed with hand-ground mustard, fennel, amchur, and roasted spices.</p>

            <h2>3. Sweet & Tangy Khatti Meethi Gorkeri</h2>
            <p>Prized Gujarati sweet mango pickle slow-infused in natural organic jaggery syrup with cinnamon and cloves.</p>

            <h2>4. Sun-Dried Spicy Garlic Chutney / Achar (Lasan Achar)</h2>
            <p>Pounded garlic cloves sun-dried and pickled in a hot red chilli & mustard oil infusion.</p>

            <h2>5. Salt-Cured Digestive Lemon Pickle (Nimbu Ka Achar)</h2>
            <p>Thin-skinned juicy lemons cured slowly in rock salt (Sendha Namak), ajwain, and black pepper.</p>
          {%- endif -%}
        </article>

        <!-- AUTHOR BIO CARD -->
        <div class="dp-author-bio">
          <div class="dp-author-bio__avatar">👵</div>
          <div class="dp-author-bio__details">
            <h4>About Baa (Mother of Founder)</h4>
            <p>
              Baa has been handcrafting traditional Gujarati pickles, papads, and chutneys for over 45 years in Saurashtra. Every batch produced at DivyaPrabha Foods is personally tasted and approved by Baa.
            </p>
            <a href="/pages/about-us" class="dp-author-bio__link">Read Our Family Story →</a>
          </div>
        </div>

        <!-- COMMENT FORM -->
        {%- include 'blog-comment-form' -%}
      </main>

      <!-- RIGHT COLUMN: STICKY BRAND SIDEBAR -->
      <aside class="dp-article-sidebar">
        <div class="dp-sticky-sidebar-inner">
          
          <!-- WIDGET 1: OUR PRODUCTS -->
          <div class="dp-sidebar-widget dp-sidebar-widget--products">
            <div class="dp-widget-title-wrap">
              <span class="dp-widget-icon">🫙</span>
              <h3 class="dp-widget-title">Our Pickles & Products</h3>
            </div>
            <div class="dp-sidebar-products-list">
              {% assign sidebar_collection = collections['all'] %}
              {% if sidebar_collection.products.size > 0 %}
                {% for product in sidebar_collection.products limit: 5 %}
                  <div class="dp-product-mini-card">
                    <div class="dp-product-mini-card__img">
                      <a href="{{ product.url }}">
                        {% if product.featured_image %}
                          <img src="{{ product.featured_image | image_url: width: 200 }}" alt="{{ product.title | escape }}" loading="lazy">
                        {% else %}
                          <div class="dp-product-mini-card__placeholder">🫙</div>
                        {% endif %}
                      </a>
                      {% if product.compare_at_price > product.price %}
                        <span class="dp-mini-badge">Sale</span>
                      {% elsif forloop.first %}
                        <span class="dp-mini-badge">Bestseller</span>
                      {% endif %}
                    </div>
                    <div class="dp-product-mini-card__info">
                      <h4><a href="{{ product.url }}">{{ product.title }}</a></h4>
                      <div class="dp-product-price">
                        <span class="dp-price-current">{{ product.price | money }}</span>
                        {% if product.compare_at_price > product.price %}
                          <span class="dp-price-old">{{ product.compare_at_price | money }}</span>
                        {% endif %}
                      </div>
                      <a href="{{ product.url }}" class="dp-mini-buy-btn">Buy Now →</a>
                    </div>
                  </div>
                {% endfor %}
              {% endif %}
            </div>
          </div>

          <!-- WIDGET 2: ALL CATEGORIES -->
          <div class="dp-sidebar-widget dp-sidebar-widget--categories">
            <div class="dp-widget-title-wrap">
              <span class="dp-widget-icon">📂</span>
              <h3 class="dp-widget-title">Categories</h3>
            </div>
            <ul class="dp-category-list">
              {% assign art_core_cats = "Heritage Recipes,Health & Spices,Buying Guides,Pickle Pairings,Artisanal Craft" | split: "," %}
              {% for cat_item in art_core_cats %}
                {% assign cat_clean = cat_item | strip %}
                {% assign cat_lower = cat_clean | downcase %}
                {% assign cat_count = 0 %}
                {% for art in blog.articles %}
                  {% if art.tags contains cat_clean %}
                    {% assign cat_count = cat_count | plus: 1 %}
                  {% endif %}
                {% endfor %}
                <li>
                  <a href="{{ blog.url }}/tagged/{{ cat_clean | handle }}">
                    <span>{% if cat_lower contains 'heritage' %}🥭{% elsif cat_lower contains 'health' %}🌶️{% elsif cat_lower contains 'buy' %}🛒{% elsif cat_lower contains 'pair' %}🍱{% else %}🫙{% endif %} {{ cat_clean }}</span>
                    <span class="dp-cat-count">({{ cat_count }})</span>
                  </a>
                </li>
              {% endfor %}
            </ul>
          </div>

          <!-- WIDGET 3: BLOG TOPICS / RECENT POSTS -->
          <div class="dp-sidebar-widget dp-sidebar-widget--topics">
            <div class="dp-widget-title-wrap">
              <span class="dp-widget-icon">📝</span>
              <h3 class="dp-widget-title">Blog Topics</h3>
            </div>
            <ul class="dp-recent-topics-list">
              {% if blog.articles.size > 0 %}
                {% for art_topic in blog.articles limit: 6 %}
                  <li>
                    <span class="dp-topic-tag">{{ art_topic.tags.first | default: "Recipe" }}</span>
                    <a href="{{ art_topic.url }}">{{ art_topic.title }}</a>
                  </li>
                {% endfor %}
              {% endif %}
            </ul>
          </div>

          <!-- WIDGET 4: AUTOMATIC FOCUS KEYWORDS / TAG CLOUD -->
          <div class="dp-sidebar-widget dp-sidebar-widget--tags">
            <div class="dp-widget-title-wrap">
              <span class="dp-widget-icon">🏷️</span>
              <h3 class="dp-widget-title">Focus Keywords</h3>
            </div>
            <div class="dp-keywords-cloud dp-keywords-cloud--collapsed" id="dpKeywordsCloud">
              {% if blog.all_tags.size > 0 %}
                {% assign categories_filter = "Heritage Recipes,Health & Spices,Buying Guides,Pickle Pairings,Artisanal Craft" %}
                {% for tag in blog.all_tags %}
                  {% assign tag_clean = tag | strip %}
                  {% unless categories_filter contains tag_clean %}
                    {% assign is_current_tag = false %}
                    {% if article.tags contains tag_clean %}
                      {% assign is_current_tag = true %}
                    {% endif %}
                    <a href="{{ blog.url }}/tagged/{{ tag_clean | handle }}" class="dp-tag-pill {% if is_current_tag %}active{% endif %}">#{{ tag_clean }}</a>
                  {% endunless %}
                {% endfor %}
              {% endif %}
            </div>
            <button type="button" class="dp-show-more-tags-btn" id="dpShowMoreTagsBtn" onclick="toggleDpKeywords()">
              <span class="dp-btn-text">+ Show More Keywords</span>
              <span class="dp-btn-arrow">↓</span>
            </button>
          </div>

        </div>
      </aside>

    </div>
  </div>
</section>

